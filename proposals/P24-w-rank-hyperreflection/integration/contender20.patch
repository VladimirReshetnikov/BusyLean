diff --git a/BusyLean/TransfiniteHyperReflection.lean b/BusyLean/TransfiniteHyperReflection.lean
new file mode 100644
index 0000000..7d99c5b
--- /dev/null
+++ b/BusyLean/TransfiniteHyperReflection.lean
@@ -0,0 +1,187 @@
+import BusyLean.HyperReflectionFacts
+
+/-!
+# W-rank hyperreflection
+
+`diagonalLift` is indexed by a natural-number rank.  This module raises the
+construction one type level.  A `HyperLift` transforms transformer lifts, and
+`runHyperLift` iterates such an operation along a countably branching
+well-founded `WTree Nat`.
+
+The important proof invariant is `GoodLift`: a lift preserves progressive
+transformers and is strictly inflationary.  No monotonicity in an oracle is
+used.  The strict comparison follows an explicit child and an explicit splice
+coordinate, exactly as in the first-order reflection proofs.
+
+All definitions are structural and executable.
+-/
+
+namespace BusyLean
+
+open BigNumber (WTree)
+open BusyLean.W
+
+/-- One type level above `TransformerLift`. -/
+abbrev HyperLift := TransformerLift → TransformerLift
+
+/-- The two invariants needed to iterate a transformer lift safely. -/
+abbrev GoodLift (lift : TransformerLift) : Prop :=
+  PreservesProgressive lift ∧ StrictlyInflationary lift
+
+/-- A hyperlift maps good lifts to good lifts. -/
+abbrev PreservesGoodLift (op : HyperLift) : Prop :=
+  ∀ lift, GoodLift lift → GoodLift (op lift)
+
+/-- A hyperlift strictly exceeds its input lift at every visible coordinate. -/
+abbrev StrictlyInflationary2 (op : HyperLift) : Prop :=
+  ∀ (lift : TransformerLift), GoodLift lift →
+    ∀ (base : Transformer), Progressive base →
+      ∀ (seed : Family) (i o n : Nat), i ≤ n →
+        lift base seed i n < op lift base seed o n
+
+/-- Assemble a countable family of transformer lifts.  Output coordinate `i`
+selects lift `i`; that lift is read at its canonical transformer coordinate
+`0`, through `spliceTransformers`. -/
+def spliceLifts (lifts : Nat → TransformerLift) : TransformerLift :=
+  fun base => spliceTransformers (fun i => lifts i base)
+
+/-- One rank step over a fixed schedule.  The input lift is used twice: first
+to amplify the base and then as the local lift throughout the schedule. -/
+def rankStep (schedule : WTree Nat) : HyperLift :=
+  fun lift base => stageLift lift (lift base) schedule
+
+/-- Iterate a hyperlift along a well-founded tree.
+
+At a leaf, apply the hyperlift once.  At a node, recursively construct one lift
+per child, splice those lifts, and apply the hyperlift to the splice. -/
+def runHyperLift (op : HyperLift) (seed : TransformerLift) :
+    WTree Nat → TransformerLift
+  | .leaf => op seed
+  | .node f =>
+      op (spliceLifts (fun i => runHyperLift op seed (f i)))
+
+/-- W-tree-indexed diagonal lifting over a fixed inner schedule. -/
+def treeDiagonalLift (schedule rankTree : WTree Nat)
+    (seed : TransformerLift) : TransformerLift :=
+  runHyperLift (rankStep schedule) seed rankTree
+
+/-- Splicing preserves the progressive-preservation invariant. -/
+theorem spliceLifts_preservesProgressive {lifts : Nat → TransformerLift}
+    (hlifts : ∀ i, PreservesProgressive (lifts i)) :
+    PreservesProgressive (spliceLifts lifts) := by
+  intro base hbase
+  exact spliceTransformers_progressive (fun i => hlifts i base hbase)
+
+/-- Splicing preserves strict inflationarity. -/
+theorem spliceLifts_strictlyInflationary {lifts : Nat → TransformerLift}
+    (hlifts : ∀ i, StrictlyInflationary (lifts i)) :
+    StrictlyInflationary (spliceLifts lifts) := by
+  intro base hbase seed i o n hi
+  change base seed i n < lifts o base seed 0 n
+  exact hlifts o base hbase seed i 0 n hi
+
+/-- A splice of good lifts is good. -/
+theorem spliceLifts_good {lifts : Nat → TransformerLift}
+    (hlifts : ∀ i, GoodLift (lifts i)) :
+    GoodLift (spliceLifts lifts) :=
+  ⟨spliceLifts_preservesProgressive (fun i => (hlifts i).1),
+    spliceLifts_strictlyInflationary (fun i => (hlifts i).2)⟩
+
+/-- One rank step maps good lifts to good lifts. -/
+theorem rankStep_preservesGood (schedule : WTree Nat) :
+    PreservesGoodLift (rankStep schedule) := by
+  intro lift hlift
+  rcases hlift with ⟨hpres, hstrict⟩
+  constructor
+  · intro base hbase
+    change Progressive (stageLift lift (lift base) schedule)
+    exact stageLift_progressive lift hpres
+      (lift base) (hpres base hbase) schedule
+  · intro base hbase seed i o n hi
+    change base seed i n <
+      stageLift lift (lift base) schedule seed o n
+    have hfirst : base seed i n < lift base seed i n :=
+      hstrict base hbase seed i i n hi
+    have hsecond : lift base seed i n <
+        stageLift lift (lift base) schedule seed o n :=
+      base_lt_stageLift lift hpres hstrict
+        (lift base) (hpres base hbase) schedule seed i o n hi
+    exact Nat.lt_trans hfirst hsecond
+
+/-- One rank step is strictly inflationary at the level of lifts. -/
+theorem rankStep_strictlyInflationary2 (schedule : WTree Nat) :
+    StrictlyInflationary2 (rankStep schedule) := by
+  intro lift hlift base hbase seed i o n hi
+  rcases hlift with ⟨hpres, hstrict⟩
+  change lift base seed i n <
+    stageLift lift (lift base) schedule seed o n
+  exact base_lt_stageLift lift hpres hstrict
+    (lift base) (hpres base hbase) schedule seed i o n hi
+
+/-- W-tree iteration preserves goodness. -/
+theorem runHyperLift_good (op : HyperLift)
+    (hop : PreservesGoodLift op)
+    (seed : TransformerLift) (hseed : GoodLift seed) :
+    (a : WTree Nat) → GoodLift (runHyperLift op seed a)
+  | .leaf => hop seed hseed
+  | .node f =>
+      hop
+        (spliceLifts (fun i => runHyperLift op seed (f i)))
+        (spliceLifts_good
+          (fun i => runHyperLift_good op hop seed hseed (f i)))
+
+/-- Every W-tree stage strictly exceeds its seed lift.
+
+The node case follows child zero, identifies it with coordinate zero of the
+splice, and then applies strictness of the hyperlift. -/
+theorem seed_lt_runHyperLift (op : HyperLift)
+    (hpres : PreservesGoodLift op)
+    (hstrict : StrictlyInflationary2 op)
+    (seedLift : TransformerLift) (hseed : GoodLift seedLift) :
+    (a : WTree Nat) →
+      ∀ (base : Transformer), Progressive base →
+        ∀ (seed : Family) (i o n : Nat), i ≤ n →
+          seedLift base seed i n <
+            runHyperLift op seedLift a base seed o n
+  | .leaf, base, hbase, seed, i, o, n, hi =>
+      hstrict seedLift hseed base hbase seed i o n hi
+  | .node f, base, hbase, seed, i, o, n, hi => by
+      have hchild :
+          seedLift base seed i n <
+            runHyperLift op seedLift (f 0) base seed 0 n :=
+        seed_lt_runHyperLift op hpres hstrict seedLift hseed
+          (f 0) base hbase seed i 0 n hi
+      have hsplice : GoodLift
+          (spliceLifts (fun j => runHyperLift op seedLift (f j))) :=
+        spliceLifts_good
+          (fun j => runHyperLift_good op hpres seedLift hseed (f j))
+      have hparent := hstrict
+        (spliceLifts (fun j => runHyperLift op seedLift (f j)))
+        hsplice base hbase seed 0 o n (Nat.zero_le n)
+      change
+        runHyperLift op seedLift (f 0) base seed 0 n <
+          runHyperLift op seedLift (.node f) base seed o n at hparent
+      exact Nat.lt_trans hchild hparent
+
+/-- The W-rank diagonal lift is good whenever its seed lift is good. -/
+theorem treeDiagonalLift_good (schedule rankTree : WTree Nat)
+    (seed : TransformerLift) (hseed : GoodLift seed) :
+    GoodLift (treeDiagonalLift schedule rankTree seed) := by
+  simpa [treeDiagonalLift] using
+    runHyperLift_good (rankStep schedule)
+      (rankStep_preservesGood schedule) seed hseed rankTree
+
+/-- The W-rank diagonal lift strictly exceeds its seed lift. -/
+theorem seed_lt_treeDiagonalLift (schedule rankTree : WTree Nat)
+    (seedLift : TransformerLift) (hseed : GoodLift seedLift)
+    (base : Transformer) (hbase : Progressive base)
+    (seed : Family) (i o n : Nat) (hi : i ≤ n) :
+    seedLift base seed i n <
+      treeDiagonalLift schedule rankTree seedLift base seed o n := by
+  simpa [treeDiagonalLift] using
+    seed_lt_runHyperLift (rankStep schedule)
+      (rankStep_preservesGood schedule)
+      (rankStep_strictlyInflationary2 schedule)
+      seedLift hseed rankTree base hbase seed i o n hi
+
+end BusyLean
diff --git a/BusyLean/Contender20.lean b/BusyLean/Contender20.lean
new file mode 100644
index 0000000..70b3d7c
--- /dev/null
+++ b/BusyLean/Contender20.lean
@@ -0,0 +1,66 @@
+import BusyLean.TransfiniteHyperReflection
+import BusyLean.Contender19
+
+/-!
+# Contender 20: W-rank hyperreflection
+
+```
+family19 n      := F19 (F19 n)
+seedLift20 n    := diagonalLift (schedule20 n) (family19 n + 1)
+lift20 n        := treeDiagonalLift (schedule20 n) (rankTree20 n) (seedLift20 n)
+F20 n           := lift20 n lTransformer seedFamily20 n n
+contender_20     := F20 (F20 42)
+```
+
+Contender 19 uses a natural-number rank of transformer lifts.  Contender 20
+raises the rank mechanism one type level and iterates it along a countably
+branching well-founded tree.  At an outer node, the recursively generated child
+lifts are spliced into a single lift, then one diagonal rank step is applied.
+
+The seed is already a diagonal lift of rank `family19 n + 1`.  The outer rank
+tree is an autonomous hyperclosure above a schedule that is itself an
+autonomous hyperclosure above Contender 19's schedule.  The object-language
+transformer remains the large-Veblen-ladder reflector.
+
+Do not evaluate `contender_20`.
+-/
+
+namespace BusyLean
+
+open BigNumber (WTree)
+open BusyLean.W
+
+/-- Contender 19's construction as a function of its input. -/
+def family19 (n : Nat) : Nat := F19 (F19 n)
+
+/-- The constant oracle family used by Contender 20. -/
+def seedFamily20 : Family := fun _ => family19
+
+/-- Inner schedule: a self-height autonomous closure above Contender 19's
+schedule. -/
+def schedule20 (n : Nat) : WTree Nat :=
+  Autonomous.realize
+    (Autonomous.hyper (family19 n + 42) (Autonomous.encode (schedule19 n)))
+
+/-- Outer W-rank: another self-height autonomous closure, now above the inner
+schedule itself. -/
+def rankTree20 (n : Nat) : WTree Nat :=
+  Autonomous.realize
+    (Autonomous.hyper (family19 n + 42) (Autonomous.encode (schedule20 n)))
+
+/-- The finite-rank lift from which the W-rank closure starts. -/
+def seedLift20 (n : Nat) : TransformerLift :=
+  diagonalLift (schedule20 n) (family19 n + 1)
+
+/-- The W-rank lift used at input `n`. -/
+def lift20 (n : Nat) : TransformerLift :=
+  treeDiagonalLift (schedule20 n) (rankTree20 n) (seedLift20 n)
+
+/-- Pointwise Contender-20 family. -/
+def F20 (n : Nat) : Nat :=
+  lift20 n lTransformer seedFamily20 n n
+
+/-- Contender 20.  Never evaluate it. -/
+def contender_20 : Nat := F20 (F20 42)
+
+end BusyLean
diff --git a/BusyLean/Comparison20.lean b/BusyLean/Comparison20.lean
new file mode 100644
index 0000000..ea4a149
--- /dev/null
+++ b/BusyLean/Comparison20.lean
@@ -0,0 +1,82 @@
+import BusyLean.Contender20
+import BusyLean.Comparison19
+
+/-! # Contender 20: comparison theorems -/
+
+namespace BusyLean
+
+open BusyLean.W
+
+/-- The finite-rank seed lift satisfies both iteration invariants. -/
+theorem seedLift20_good (n : Nat) : GoodLift (seedLift20 n) :=
+  ⟨diagonalLift_preservesProgressive (schedule20 n) (family19 n + 1),
+    diagonalLift_strictlyInflationary (schedule20 n) (family19 n + 1)⟩
+
+/-- The full W-rank lift satisfies both iteration invariants. -/
+theorem lift20_good (n : Nat) : GoodLift (lift20 n) := by
+  simpa [lift20] using
+    treeDiagonalLift_good (schedule20 n) (rankTree20 n)
+      (seedLift20 n) (seedLift20_good n)
+
+/-- The raw large-Veblen reflection exceeds the Contender-19 seed family. -/
+theorem family19_lt_raw20 (n : Nat) :
+    family19 n < lTransformer seedFamily20 0 n := by
+  change seedFamily20 0 n < lTransformer seedFamily20 0 n
+  exact lTransformer_progressive seedFamily20 0 0 n (Nat.zero_le n)
+
+/-- The finite diagonal rank strictly exceeds raw reflection. -/
+theorem raw20_lt_seedLift20 (n : Nat) :
+    lTransformer seedFamily20 0 n <
+      seedLift20 n lTransformer seedFamily20 0 n := by
+  simpa [seedLift20] using
+    (diagonalLift_strictlyInflationary
+      (schedule20 n) (family19 n + 1))
+      lTransformer lTransformer_progressive
+      seedFamily20 0 0 n (Nat.zero_le n)
+
+/-- The outer W-rank stage strictly exceeds its already enormous seed lift. -/
+theorem seedLift20_lt_F20 (n : Nat) :
+    seedLift20 n lTransformer seedFamily20 0 n < F20 n := by
+  change seedLift20 n lTransformer seedFamily20 0 n <
+    lift20 n lTransformer seedFamily20 n n
+  simpa [lift20] using
+    seed_lt_treeDiagonalLift (schedule20 n) (rankTree20 n)
+      (seedLift20 n) (seedLift20_good n)
+      lTransformer lTransformer_progressive
+      seedFamily20 0 n n (Nat.zero_le n)
+
+/-- Raw reflection is below the complete Contender-20 stage. -/
+theorem raw_reflection20_lt_F20 (n : Nat) :
+    reflectLFamily seedFamily20 n < F20 n := by
+  change lTransformer seedFamily20 0 n < F20 n
+  exact Nat.lt_trans (raw20_lt_seedLift20 n) (seedLift20_lt_F20 n)
+
+/-- Pointwise domination of Contender 19's family. -/
+theorem family19_lt_F20 (n : Nat) : family19 n < F20 n :=
+  Nat.lt_trans (family19_lt_raw20 n) (raw_reflection20_lt_F20 n)
+
+/-- Every large-Veblen-ladder program in the bounded enumeration lies below
+`F20 n`. -/
+theorem lvalue_lt_F20 {n : Nat} {t : FL.CTm Ordinal.LargeVeblen}
+    (ht : t ∈ FL.lveblenLadderUpTo n) :
+    FL.lvalue (packFamily seedFamily20) n t < F20 n :=
+  Nat.lt_trans (lvalue_lt_reflectLFamily seedFamily20 ht)
+    (raw_reflection20_lt_F20 n)
+
+/-- The input is below Contender 19's self-composed family. -/
+theorem input_lt_family19 (n : Nat) : n < family19 n :=
+  Nat.lt_trans (input_lt_F19 n) (input_lt_F19 (F19 n))
+
+/-- Every input is below the corresponding Contender-20 family value. -/
+theorem input_lt_F20 (n : Nat) : n < F20 n :=
+  Nat.lt_trans (input_lt_family19 n) (family19_lt_F20 n)
+
+/-- The required formal comparison. -/
+theorem contender_19_lt_contender_20 : contender_19 < contender_20 :=
+  Nat.lt_trans (family19_lt_F20 42) (input_lt_F20 (F20 42))
+
+/-- A convenient inherited comparison. -/
+theorem contender_18_lt_contender_20 : contender_18 < contender_20 :=
+  Nat.lt_trans contender_18_lt_contender_19 contender_19_lt_contender_20
+
+end BusyLean
diff --git a/test/Audit20.lean b/test/Audit20.lean
new file mode 100644
index 0000000..53bf8a7
--- /dev/null
+++ b/test/Audit20.lean
@@ -0,0 +1,54 @@
+import BusyLean.Comparison20
+import Lean
+
+/-! Focused audit for Contender 20. -/
+
+open Lean Elab Command
+
+/-- Constants reachable from a declaration through types and values. -/
+def constClosure20 (env : Environment) (root : Name) : NameSet := Id.run do
+  let mut seen : NameSet := {}
+  let mut stack := #[root]
+  while stack.size > 0 do
+    let c := stack.back!
+    stack := stack.pop
+    if seen.contains c then continue
+    seen := seen.insert c
+    let some ci := env.find? c | continue
+    let body : Array Name := match ci with
+      | .defnInfo v => v.value.getUsedConstants
+      | .thmInfo v => v.value.getUsedConstants
+      | .opaqueInfo v => v.value.getUsedConstants
+      | _ => #[]
+    stack := stack ++ ci.type.getUsedConstants ++ body
+  return seen
+
+/-- Fail if a forbidden declaration occurs in the closure of `root`. -/
+elab "#assert_not_in_closure20 " root:ident " : " bad:ident* : command => do
+  let env ← getEnv
+  let r ← liftCoreM <| realizeGlobalConstNoOverloadWithInfo root
+  let cl := constClosure20 env r
+  for b in bad do
+    let n ← liftCoreM <| realizeGlobalConstNoOverloadWithInfo b
+    if cl.contains n then
+      throwError m!"{r} depends on forbidden constant {n}"
+  logInfo m!"{r}: closure of {cl.size} constants avoids all {bad.size} forbidden names"
+
+#print axioms BusyLean.contender_20
+#print axioms BusyLean.contender_19_lt_contender_20
+#print axioms BusyLean.family19_lt_F20
+#print axioms BusyLean.lvalue_lt_F20
+#print axioms BusyLean.seed_lt_runHyperLift
+#print axioms BusyLean.treeDiagonalLift_good
+
+#assert_not_in_closure20 BusyLean.contender_20 :
+  BusyLean.contender_19 BusyLean.contender_18 BusyLean.contender_17
+  BusyLean.contender_16 BusyLean.contender_15 BusyLean.contender_14
+  BusyLean.contender_13 BusyLean.contender_12 BusyLean.contender_11
+  BusyLean.contender_10 BusyLean.contender_9 BusyLean.contender_8
+  BusyLean.contender_7 BusyLean.contender_6 BusyLean.contender_5
+
+#check @BusyLean.contender_19_lt_contender_20
+#check @BusyLean.family19_lt_F20
+#check @BusyLean.lvalue_lt_F20
+#check @BusyLean.seed_lt_treeDiagonalLift
