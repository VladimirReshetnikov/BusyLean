@@ -0,0 +1,1219 @@
+\documentclass[11pt]{article}
+\usepackage[T1]{fontenc}
+\usepackage{lmodern}
+\usepackage{amsmath,amssymb,amsthm,mathtools}
+\usepackage{microtype}
+\usepackage[margin=0.92in]{geometry}
+\usepackage{booktabs,longtable,array}
+\usepackage{enumitem}
+\usepackage{xcolor}
+\usepackage{listings}
+\usepackage{fancyhdr}
+\usepackage{hyperref}
+
+\hypersetup{
+  colorlinks=true,
+  linkcolor=blue!45!black,
+  urlcolor=blue!50!black,
+  citecolor=blue!45!black,
+  pdftitle={Contender 20: W-Rank Hyperreflection in BusyLean},
+  pdfauthor={Research proposal for BusyLean}
+}
+
+\pagestyle{fancy}
+\fancyhf{}
+\fancyhead[L]{BusyLean Contender 20}
+\fancyhead[R]{W-rank hyperreflection}
+\fancyfoot[C]{\thepage}
+\setlength{\headheight}{14pt}
+
+\lstdefinelanguage{lean}{
+  keywords={abbrev,def,theorem,inductive,structure,where,match,with,fun,let,in,
+    namespace,end,open,import,by,have,show,exact,simpa,using,change,intro,rcases,
+    constructor,at},
+  sensitive=true,
+  morecomment=[l]{--},
