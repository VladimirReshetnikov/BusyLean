namespace BigNumber.Amplifier

/-- Finite iteration, with the initial application exposed definitionally. -/
def iterate {α : Type u} (f : α → α) : Nat → α → α
  | 0, x => x
  | n + 1, x => iterate f n (f x)

/-- A countably branching, inductively well-founded tree. -/
inductive Tree : Type where
  | zero : Tree
  | succ : Tree → Tree
  | limit : (Nat → Tree) → Tree

/-- The complete evaluator. All recursive calls are to immediate subtrees. -/
def fast (b : Nat → Nat) : Tree → Nat → Nat
  | .zero, n => b n
  | .succ a, n => iterate (fast b a) (n + 1) n
  | .limit f, n => fast b (f n) n

/-- Substitute `a` for every zero leaf of the second argument. -/
def graft (a : Tree) : Tree → Tree
  | .zero => a
  | .succ t => .succ (graft a t)
  | .limit f => .limit (fun n => graft a (f n))

/-- A syntactic orbit supremum; no quotient by ordinal equality is used. -/
def orbitLimit (f : Tree → Tree) (a : Tree) : Tree :=
  .limit (fun n => iterate f (n + 1) a)

def omegaPower : Tree → Tree
  | .zero => .succ .zero
  | .succ a => .limit (fun n => iterate (graft (omegaPower a)) n .zero)
  | .limit f => .limit (fun n => omegaPower (f n))

/-- Enumeration generated by a supplied closure constructor. -/
def enumClosure (c : Tree → Tree) : Tree → Tree
  | .zero => c .zero
  | .succ a => c (.succ (enumClosure c a))
  | .limit f => .limit (fun n => enumClosure c (f n))

def prefixApply (fs : Nat → Tree → Tree) : Nat → Tree → Tree
  | 0, a => a
  | n + 1, a => fs n (prefixApply fs n a)

def sweep (fs : Nat → Tree → Tree) : Nat → Tree → Tree
  | 0, a => a
  | n + 1, a => prefixApply fs (n + 1) (sweep fs n a)

def commonLimit (fs : Nat → Tree → Tree) (a : Tree) : Tree :=
  .limit (fun n => sweep fs (n + 1) a)

/-- Explicit Veblen-inspired syntax, without an ordinal calibration assertion. -/
def veblenTree : Tree → Tree → Tree
  | .zero, a => omegaPower a
  | .succ t, a => enumClosure (orbitLimit (veblenTree t)) a
  | .limit f, a => enumClosure (commonLimit (fun n => veblenTree (f n))) a

def gammaSeed : Tree := orbitLimit (fun a => veblenTree a .zero) .zero

/-- A finite but dynamically selectable tower of higher function spaces. -/
def Level : Nat → Type
  | 0 => Tree
  | k + 1 => Level k → Level k

def pointSucc : (k : Nat) → Level k → Level k
  | 0, a => .succ a
  | k + 1, f => fun x => pointSucc k (f x)

def pointLimit : (k : Nat) → (Nat → Level k) → Level k
  | 0, f => .limit f
  | k + 1, fs => fun x => pointLimit k (fun n => fs n x)

def omegaIteration (k : Nat) (f : Level (k + 1)) : Level (k + 1) :=
  fun x => pointLimit k (fun n => iterate f (n + 1) (pointSucc k x))

def baseOperator : (k : Nat) → Level (k + 1)
  | 0 => omegaPower
  | k + 1 => omegaIteration k

def lower : (k : Nat) → Level (k + 1) → Tree → Tree
  | 0, f => f
  | k + 1, f => lower k (f (baseOperator k))

def higherSeed (k : Nat) : Tree := lower k (baseOperator k) gammaSeed

def advance (b : Nat → Nat) (a : Tree) : Tree :=
  let t := higherSeed (fast b a 64 + 64)
  graft (.succ a) (veblenTree (graft a t) (graft t a))

/-- An explicit tower of twos, with height supplied by an earlier score. -/
def tower2 : Nat → Nat
  | 0 => 1
  | k + 1 => 2 ^ tower2 k

def stage (b : Nat → Nat) (a : Tree) : Tree :=
  iterate (advance b) (tower2 (fast b a 64 + 1)) a

def ladder (b : Nat → Nat) : Nat → Tree
  | 0 => higherSeed 64
  | k + 1 => stage b (ladder b k)

def seedScore (b : Nat → Nat) : Nat := fast b (higherSeed 64) 64

/-- The proposed score, parameterized only by an explicitly supplied base. -/
def candidate (b : Nat → Nat) : Nat := fast b (ladder b (seedScore b)) 64

/-- A transparent numeric lower bound for the full tree construction. -/
def towerFeedback (seed : Nat) : Nat → Nat
  | 0 => seed
  | k + 1 => tower2 (towerFeedback seed k + 1)

end BigNumber.Amplifier
