@@ -0,0 +1,71 @@
+import BusyLean.Comparison11
+import Lean
+
+/-!
+# Contender 11 audit
+
+Run with:
+
+```
+lake env lean test/Contender11Audit.lean
+```
+
+The file prints axiom dependencies, checks the required theorem statements, and
+uses a transitive constant-closure audit to verify that the new definition does
+not mention any earlier contender constant.
+-/
+
+open Lean Elab Command
+
+/-- All constants reachable from `root` through declaration types and values. -/
+def constClosure11 (env : Environment) (root : Name) : NameSet := Id.run do
+  let mut seen : NameSet := {}
+  let mut stack := #[root]
+  while stack.size > 0 do
+    let c := stack.back!
+    stack := stack.pop
+    if seen.contains c then continue
+    seen := seen.insert c
+    let some ci := env.find? c | continue
+    let body : Array Name := match ci with
+      | .defnInfo v => v.value.getUsedConstants
+      | .thmInfo v => v.value.getUsedConstants
+      | .opaqueInfo v => v.value.getUsedConstants
+      | _ => #[]
+    stack := stack ++ ci.type.getUsedConstants ++ body
+  return seen
+
+/-- Fail if any listed constant occurs in the transitive closure of `root`. -/
+elab "#assert_not_in_closure11 " root:ident " : " bad:ident* : command => do
+  let env ← getEnv
+  let r ← liftCoreM <| realizeGlobalConstNoOverloadWithInfo root
+  let cl := constClosure11 env r
+  for b in bad do
+    let n ← liftCoreM <| realizeGlobalConstNoOverloadWithInfo b
+    if cl.contains n then
+      throwError m!"{r} depends on forbidden constant {n}"
+  logInfo m!"{r}: closure of {cl.size} constants avoids all {bad.size} names"
+
+-- Axiom reports. The repository checker should accept only `propext` and
+-- `Quot.sound`.
+#print axioms BusyLean.contender_11
+#print axioms BusyLean.contender_10_lt_contender_11
+#print axioms BusyLean.seed_lt_round11
+#print axioms BusyLean.tower11_step_lt
+#print axioms BusyLean.family10_lt_F11
+#print axioms BusyLean.defined_tree_eventually_lt11
+#print axioms BusyLean.fvalue_lt_round11
+
+-- No earlier contender value is used to define the new number. Only the
+-- preceding construction `F10` appears, through `family10`.
+#assert_not_in_closure11 BusyLean.contender_11 :
+  BusyLean.contender_10 BusyLean.contender_9 BusyLean.contender_8
+  BusyLean.contender_7 BusyLean.contender_6 BusyLean.contender_5
+
+-- Record the central statements in a compact, compiler-checkable form.
+#check @BusyLean.contender_10_lt_contender_11
+#check @BusyLean.family10_lt_F11
+#check @BusyLean.input_lt_F11
+#check @BusyLean.tower11_step_lt
+#check @BusyLean.defined_tree_eventually_lt11
+#check @BusyLean.fvalue_lt_round11
