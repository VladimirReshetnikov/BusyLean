import BusyLean.Contender6

/-!
# Contender 7: ramification of semantic worlds

Definitions only. Do not evaluate `contender_7`, `levels 42`, or any large
bounded program maximum. This file is supplied as uncompiled Lean source;
see VALIDATION.md for the exact validation status.
-/
namespace BusyLean.V7

open BigNumber (Ty Term Value WTree)
open BusyLean.W (Family oracleTy prefixMax)

abbrev Tree := WTree Nat
abbrev Runner := Family → Tree → Nat → Nat

/-- A complete lower-world tree-recursion operator and its program index. -/
structure World where
  run : Runner
  index : Tree

/-- The old machinery, not the old named contender or its final family. -/
def baseWorld : World :=
  ⟨BusyLean.W.stage, BusyLean.index⟩

/-- Score a world using the existing constructive seed family. -/
def score (w : World) (n : Nat) : Nat :=
  w.run BusyLean.p5Family w.index n

def treeTy : Ty := .wt .nat
def unaryTy : Ty := .arr .nat .nat
def runnerTy : Ty := .arr oracleTy (.arr treeTy unaryTy)
def runnersTy : Ty := .arr .nat runnerTy
def indicesTy : Ty := .arr .nat treeTy
def iterateTy : Ty := .arr unaryTy (.arr .nat (.arr .nat .nat))

deriving instance DecidableEq for Ty

/-- Exact type equality, not the old language's coercive arrow/tree casts. -/
def castExact (b : Ty) (v : Value) : BigNumber.den b :=
  match v with
  | ⟨a, x⟩ =>
      if h : a = b then Eq.mp (congrArg BigNumber.den h) x
      else BigNumber.defaultValue b

def applyValue (v w : Value) : Value :=
  match v with
  | ⟨.arr a b, f⟩ => ⟨b, f (castExact a w)⟩
  | ⟨.nat, _⟩ => ⟨.nat, (0 : Nat)⟩
  | ⟨.wt _, _⟩ => ⟨.nat, (0 : Nat)⟩

/-- A transparent definition of 2^n, convenient for elementary proofs. -/
def exp2 : Nat → Nat
  | 0 => 1
  | n + 1 => exp2 n + exp2 n

/-- A tower with x applications of 2^(-), starting at x. -/
def tower (x : Nat) : Nat := BigNumber.iterate exp2 x x

inductive Atom where
  | zero | succ | input | oracles | lowerRun | lowerIndex | seed | iterate | exp
  deriving DecidableEq

def atoms : List Atom :=
  [.zero, .succ, .input, .oracles, .lowerRun, .lowerIndex, .seed, .iterate, .exp]

/-- Lower worlds are data supplied before this interpretation begins.
No atom names the current world's runner, index, or final number. -/
def atomValue (cs : Nat → World) (fs : Family) (n : Nat) : Atom → Value
  | .zero => ⟨.nat, (0 : Nat)⟩
  | .succ => ⟨unaryTy, Nat.succ⟩
  | .input => ⟨.nat, n⟩
  | .oracles => ⟨oracleTy, fs⟩
  | .lowerRun => ⟨runnersTy, fun i => (cs i).run⟩
  | .lowerIndex => ⟨indicesTy, fun i => (cs i).index⟩
  | .seed => ⟨oracleTy, BusyLean.p5Family⟩
  | .iterate => ⟨iterateTy, BigNumber.iterate⟩
  | .exp => ⟨unaryTy, exp2⟩

/-- A combinatory extension of the entire old W-language.
Old closed lambda terms supply arbitrary higher-type combinators. -/
inductive Program where
  | old : Term → Program
  | atom : Atom → Program
  | app : Program → Program → Program

/-- The lower-world language: no access to the live numeric forest oracle. -/
def OracleFree : Program → Prop
  | .old _ => True
  | .atom a => a ≠ Atom.oracles
  | .app p q => OracleFree p ∧ OracleFree q

def eval (cs : Nat → World) (fs : Family) (n : Nat) : Program → Value
  | .old t => BigNumber.interpret [] t
  | .atom a => atomValue cs fs n a
  | .app p q => applyValue (eval cs fs n p) (eval cs fs n q)

def natValue : Value → Nat
  | ⟨.nat, x⟩ => x
  | ⟨.arr _ _, _⟩ => 0
  | ⟨.wt _, _⟩ => 0

def evalNat (cs : Nat → World) (fs : Family) (n : Nat) (p : Program) : Nat :=
  natValue (eval cs fs n p)

/-- Cumulative, finite enumeration. Old-language leaves have their own
inherited depth bound: arbitrary old terms are NOT unit-cost literals. -/
def programs : Nat → List Program
  | 0 => []
  | n + 1 =>
      let ps := programs n
      ps ++ ((atoms.map Program.atom) ++
        (((BigNumber.allTerms (n + 1)).map Program.old) ++
          (BigNumber.cross ps ps).map (fun pq => .app pq.1 pq.2)))

/-- Reflection of the richer language, with the ordinary numeric forest
oracle kept distinct from the lower-world semantic operators. -/
def nextReflect (cs : Nat → World) (fs : Family) (n : Nat) : Nat :=
  n + 1 + BigNumber.maxN (prefixMax (fun i => fs i n) n)
    (BigNumber.maximum (evalNat cs fs n) (programs n))

/-- Generic forest recursion. Every recursive call is on a proper subtree. -/
def foldReflect (r : Family → Nat → Nat) (seed : Family) : Tree → Nat → Nat
  | .leaf => r seed
  | .node f => r (fun i => foldReflect r seed (f i))

/-- Closed tree denotation: the live numeric oracle and input are fixed at 0. -/
def programTree (cs : Nat → World) (p : Program) : Tree :=
  castExact treeTy (eval cs (fun _ _ => 0) 0 p)

/-- The index contains every tree generated by a bounded program in this
lower-world language. It is built before the new world's runner. -/
def nextIndex (cs : Nat → World) : Tree :=
  .node fun k => .node fun i =>
    programTree cs (BusyLean.nthD (programs k) i (.atom .zero))

def extend (cs : Nat → World) : World :=
  ⟨foldReflect (nextReflect cs), nextIndex cs⟩

/-- Ramify whole semantic worlds along a well-founded tree. The branch at
index 0 retains the base; branch j+1 carries the recursively generated world.
The anchor gives comparisons without any oracle-monotonicity assumption. -/
def ramify (base : World) : Tree → World
  | .leaf => extend (fun _ => base)
  | .node f => extend fun i =>
      match i with
      | 0 => base
      | j + 1 => ramify base (f j)
termination_by structural a => a

def elevate (w : World) : World := ramify w w.index

def levels : Nat → World
  | 0 => baseWorld
  | k + 1 => elevate (levels k)

/-- A uniform, computable diagonal family across the semantic strata. -/
def diagonalScore (n : Nat) : Nat := score (levels n) n

/-- Proposed Contender 7. Never evaluate this definition. -/
def contender_7 : Nat := score (levels 42) 42

/-! Explicit comparison certificates. These are syntax, not numerical guards
in the definition of the candidate. -/
def numeral : Nat → Program
  | 0 => .atom .zero
  | i + 1 => .app (.atom .succ) (numeral i)

def lowerFunction (i : Nat) : Program :=
  .app (.app (.app (.atom .lowerRun) (numeral i)) (.atom .seed))
    (.app (.atom .lowerIndex) (numeral i))

def lowerCall (i : Nat) : Program :=
  .app (lowerFunction i) (.atom .input)

def towerProgram (i : Nat) : Program :=
  .app (.app (.app (.atom .iterate) (.atom .exp)) (lowerCall i)) (lowerCall i)

/-- Iterated numerical lower bound, used only in the comparison theorem. -/
def towerOrbit (b : Nat) : Nat → Nat
  | 0 => b
  | k + 1 => tower (towerOrbit b k)

end BusyLean.V7
