namespace BusyLean7

open BigNumber (Ty Term Value Env)
abbrev Tree := BigNumber.WTree Nat
abbrev Family := BusyLean.W.Family

/-- Ordinary iteration, with a structurally decreasing natural count. -/
def iter {A : Type} (f : A → A) : Nat → A → A
  | 0, x => x
  | k + 1, x => f (iter f k x)

/-- Exponential tower with height AND starting value supplied by the input. -/
def theta (x : Nat) : Nat := iter BigNumber.pow2 (x + 1) (x + 1)

/-- The fixed interface never grows when the interpretation is strengthened. -/
structure Model where
  lowerReflect : Nat → Family → Nat → Nat
  lowerStage : Nat → Family → Tree → Nat → Nat
  lowerTree : Nat → Tree

def numFnTy : Ty := .arr .nat .nat
def familyTy : Ty := .arr .nat numFnTy
def treeTy : Ty := .wt .nat
def reflectTy : Ty := .arr familyTy numFnTy
def stageTy : Ty := .arr familyTy (.arr treeTy numFnTy)

/-- Oldest-first levels: 0=oracle, 1=input, 2=seed, 3=reflector family,
4=forest family, 5=tree family, 6=tower feedback. This order is invariant. -/
def modelEnv (M : Model) (fs : Family) (n : Nat) : Env :=
  [⟨numFnTy, theta⟩,
   ⟨.arr .nat treeTy, M.lowerTree⟩,
   ⟨.arr .nat stageTy, M.lowerStage⟩,
   ⟨.arr .nat reflectTy, M.lowerReflect⟩,
   ⟨familyTy, BusyLean.p5Family⟩,
   ⟨.nat, n⟩,
   ⟨familyTy, fs⟩]

def score (v : Value) : Nat :=
  match v with
  | ⟨.nat, n⟩ => n
  | ⟨.arr _ _, _⟩ => 0
  | ⟨.wt _, _⟩ => 0

def eval (M : Model) (fs : Family) (n : Nat) (t : Term) : Nat :=
  score (BigNumber.interpret (modelEnv M fs n) t)

/-- A finite, oracle-relative reflection operation. -/
def reflect (M : Model) (fs : Family) (n : Nat) : Nat :=
  n + 1 + BigNumber.maxN
    (BusyLean.W.prefixMax (fun i => fs i n) n)
    (BigNumber.maximum (eval M fs n) (BigNumber.allTerms n))

/-- Forest reflection with the strengthened evaluator. -/
def stage (M : Model) (seed : Family) : Tree → Nat → Nat
  | .leaf => reflect M seed
  | .node f => reflect M (fun i => stage M seed (f i))
termination_by structural a => a

def zeroFamily : Family := fun _ _ => 0

def treeOf (M : Model) (input : Nat) (t : Term) : Tree :=
  BigNumber.castValue treeTy
    (BigNumber.interpret (modelEnv M zeroFamily input) t).2

/-- Three independent indices: syntax depth, numerical parameter, program
position. No search for a well-foundedness certificate is involved. -/
def modelIndex (M : Model) : Tree :=
  .node fun depth => .node fun input => .node fun position =>
    treeOf M input
      (BusyLean.nthD (BigNumber.allTerms depth) position .zero)

/-- Internalize the current evaluator's three operations, separately. -/
def next (M : Model) : Model where
  lowerReflect := fun _ => reflect M
  lowerStage := fun _ => stage M
  lowerTree := fun _ => modelIndex M

/-- A finite ramification tower. -/
def finite (M : Model) : Nat → Model
  | 0 => M
  | k + 1 => next (finite M k)

/-- A program may select its ramification level by an arbitrary computation. -/
def omegaLift (M : Model) : Model where
  lowerReflect := fun k => reflect (finite M k)
  lowerStage := fun k => stage (finite M k)
  lowerTree := fun k => modelIndex (finite M k)

/-- Slot 0 preserves the base; slot i+1 exposes the complete child model i. -/
def join (base : Model) (children : Nat → Model) : Model where
  lowerReflect := fun k => match k with
    | 0 => reflect base
    | i + 1 => reflect (children i)
  lowerStage := fun k => match k with
    | 0 => stage base
    | i + 1 => stage (children i)
  lowerTree := fun k => match k with
    | 0 => modelIndex base
    | i + 1 => modelIndex (children i)

/-- Model-valued recursion along a well-founded schedule. Each node closes
under all finite further ramifications, while retaining every child. -/
def ramify (base : Model) : Tree → Model
  | .leaf => omegaLift base
  | .node f => omegaLift (join base (fun i => ramify base (f i)))
termination_by structural a => a

/-- Existing COMPONENTS, not the old number or its final unary family. -/
def baseModel : Model where
  lowerReflect := fun _ => BusyLean.W.reflect
  lowerStage := fun _ => BusyLean.W.stage
  lowerTree := fun _ => BusyLean.index

def initialOmega : Model := omegaLift baseModel
/-- Generated by the already strengthened language, at all natural inputs. -/
def selfSchedule : Tree := modelIndex initialOmega
def ramifiedModel : Model := ramify initialOmega selfSchedule
def finalModel : Model := omegaLift ramifiedModel

def value (M : Model) (n : Nat) : Nat :=
  stage M BusyLean.p5Family (modelIndex M) n

/-- Certificate syntax: call the selected forest on the selected index. -/
def callAt (selector : Term) : Term :=
  .app
    (.app
      (.app (.app (.var 4) selector) (.var 2))
      (.app (.var 5) selector))
    (.var 1)

/-- One uniform certificate adds tower-height feedback to that computation. -/
def amplifiedCall (selector : Term) : Term :=
  .app (.var 6) (callAt selector)

end BusyLean7

