digraph Pipeline {
  graph [rankdir=LR, bgcolor="white", fontname="Helvetica", fontsize=11,
         label="Contender 20 construction pipeline", labelloc=t,
         pad=0.20, nodesep=0.34, ranksep=0.55];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10,
        color="#555555", margin="0.12,0.08"];
  edge [fontname="Helvetica", fontsize=9, color="#555555", arrowsize=0.75];

  Prev [label="family19 n\n= F19 (F19 n)", fillcolor="#E8F1FA"];
  Sch [label="schedule20 n\nheight family19 n + 42", fillcolor="#FFF1D6"];
  Init [label="initial diagonalLift\nrank family19 n + 1", fillcolor="#FFF1D6"];
  Meta [label="superIterate\nmeta-rank family19 n + 1", fillcolor="#FBE3E3"];
  Fam [label="hyperFamily20 n\napply lift to lTransformer + seed19", fillcolor="#FBE3E3"];
  Final [label="F20 n\nreflectLFamily over whole family", fillcolor="#FFE0A3"];
  Num [label="contender_20\n= F20 (F20 42)", shape=doubleoctagon, fillcolor="#F4BD55"];

  Prev -> Sch [label="controls"];
  Sch -> Init [label="schedule"];
  Prev -> Init [label="controls rank"];
  Init -> Meta [label="initial lift"];
  Sch -> Meta [label="tree closure"];
  Prev -> Meta [label="controls meta-rank"];
  Meta -> Fam [label="lift20 n"];
  Prev -> Fam [label="seed19"];
  Fam -> Final [label="final packed oracle"];
  Final -> Num;
}
