+name: Contender 7 verification
+
+on:
+  push:
+    branches: ["research/autonomous-reflection-c7-20261012"]
+  pull_request:
+    branches: ["main"]
+  workflow_dispatch:
+
+jobs:
+  verify:
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    steps:
+      - uses: actions/checkout@v4
+      - uses: leanprover/lean-action@v1
+        with:
+          auto-config: false
+          use-github-cache: false
+      - name: Run reproducible contest checker
+        run: |
+          set -o pipefail
+          mkdir -p verification
+          python3 scripts/check.py 2>&1 | tee verification/contender7-check.log
+      - name: Record toolchain and revision
+        run: |
+          {
+            git rev-parse HEAD
+            lean --version
+            lake --version
+          } | tee verification/toolchain.txt
+      - name: Preserve verification logs
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: contender7-verification-${{ github.sha }}
+          path: verification
