@@ -0,0 +1,87 @@
+#!/usr/bin/env python3
+"""Build and audit the proposed BusyLean Contender 14.
+
+Run from the BusyLean repository root after applying the overlay:
+    python3 scripts/check14.py
+"""
+from __future__ import annotations
+
+import re
+import shutil
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+BUILD_DIRS = [
+    ROOT / ".lake" / "build",
+    ROOT / "proposals" / "P5-w-reflection" / "lean" / ".lake" / "build",
+]
+PERMITTED = {"propext", "Quot.sound"}
+PREVIOUS = "BusyLean.Comparison13"
+CURRENT_DEF = "BusyLean.Contender14"
+CURRENT_PROOF = "BusyLean.Comparison14"
+DEFINITION_BUDGET = 15.0
+PROOF_BUDGET = 60.0
+LAKE = shutil.which("lake") or "lake"
+
+
+def run(args: list[str]) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        [LAKE, *args], cwd=ROOT, capture_output=True, text=True, check=False
+    )
+
+
+def timed_build(label: str, target: str, budget: float | None) -> float:
+    start = time.monotonic()
+    build = run(["build", target])
+    elapsed = time.monotonic() - start
+    if build.returncode != 0:
+        print(build.stdout, build.stderr)
+        sys.exit(f"FAIL: {label} build failed")
+    note = f"(budget {budget:.0f} s)" if budget else "(accepted earlier)"
+    print(f"{label}: {elapsed:.1f} s {note}")
+    if budget is not None and elapsed > budget:
+        sys.exit(f"FAIL: {label} exceeded the budget")
+    return elapsed
+
+
+def audit(path: str) -> int:
+    result = run(["env", "lean", path])
+    out = result.stdout + result.stderr
+    print(out)
+    if result.returncode != 0:
+        sys.exit(f"FAIL: {path} did not run cleanly")
+    reports = re.findall(
+        r"'([^']+)' (?:depends on axioms: \[([^\]]*)\]|does not depend)", out
+    )
+    bad = [
+        (name, axs)
+        for name, axs in reports
+        if axs and set(a.strip() for a in axs.split(",")) - PERMITTED
+    ]
+    if not reports or bad:
+        sys.exit(f"FAIL: forbidden or missing axiom reports: {bad}")
+    return len(reports)
+
+
+def main() -> None:
+    for directory in BUILD_DIRS:
+        shutil.rmtree(directory, ignore_errors=True)
+
+    total = timed_build("previous contender", PREVIOUS, None)
+    total += timed_build("definitions", CURRENT_DEF, DEFINITION_BUDGET)
+    total += timed_build("proofs", CURRENT_PROOF, PROOF_BUDGET)
+    print(f"total clean build through Contender 14: {total:.1f} s")
+
+    reports = audit("test/Audit.lean")
+    reports += audit("test/Audit14.lean")
+    print(
+        f"PASS: {reports} declarations audited; axioms within "
+        f"{sorted(PERMITTED)}"
+    )
+
+
+if __name__ == "__main__":
+    main()
diff --git a/test/Audit14.lean b/test/Audit14.lean
new file mode 100644
index 0000000..d00131c
--- /dev/null
+++ b/test/Audit14.lean
@@ -0,0 +1,55 @@
+import BusyLean.Comparison14
+import Lean
+
+/-! Focused audit for Contender 14. -/
+
+open Lean Elab Command
+
+/-- All constants reachable from `root` through types and values. -/
+def constClosure14 (env : Environment) (root : Name) : NameSet := Id.run do
+  let mut seen : NameSet := {}
+  let mut stack := #[root]
+  while stack.size > 0 do
+    let c := stack.back!
+    stack := stack.pop
+    if seen.contains c then continue
+    seen := seen.insert c
+    let some ci := env.find? c | continue
+    let body : Array Name := match ci with
+      | .defnInfo v => v.value.getUsedConstants
+      | .thmInfo v => v.value.getUsedConstants
+      | .opaqueInfo v => v.value.getUsedConstants
+      | _ => #[]
+    stack := stack ++ ci.type.getUsedConstants ++ body
+  return seen
+
+/-- Fail if any forbidden constant is reachable from the root definition. -/
+elab "#assert_not_in_closure14 " root:ident " : " bad:ident* : command => do
+  let env ← getEnv
+  let r ← liftCoreM <| realizeGlobalConstNoOverloadWithInfo root
+  let cl := constClosure14 env r
+  for b in bad do
+    let n ← liftCoreM <| realizeGlobalConstNoOverloadWithInfo b
+    if cl.contains n then
+      throwError m!"{r} depends on forbidden constant {n}"
+  logInfo m!"{r}: closure of {cl.size} constants avoids all {bad.size} forbidden names"
+
+#print axioms BusyLean.contender_14
+#print axioms BusyLean.contender_13_lt_contender_14
+#print axioms BusyLean.family13_lt_F14
+#print axioms BusyLean.fvalue_lt_contender_14
+#print axioms BusyLean.rankLift_preserves
+#print axioms BusyLean.rankLift_step_lt
+#print axioms BusyLean.fixed_rank_lt_diagonalRank14
+
+#assert_not_in_closure14 BusyLean.contender_14 :
+  BusyLean.contender_13 BusyLean.contender_12 BusyLean.contender_11
+  BusyLean.contender_10 BusyLean.contender_9 BusyLean.contender_8
+  BusyLean.contender_7 BusyLean.contender_6 BusyLean.contender_5
+
+#check @BusyLean.contender_13_lt_contender_14
+#check @BusyLean.family13_lt_F14
+#check @BusyLean.fvalue_lt_contender_14
+#check @BusyLean.rankLift_preserves
+#check @BusyLean.rankLift_step_lt
+#check @BusyLean.fixed_rank_lt_diagonalRank14
