  S1 [label="spliceLifts_good"];
  L1 [label="liftLift_preservesGoodLifts"];
  L2 [label="liftLift_strictlyLiftInflationary"];
  H1 [label="stageHyperLift_good"];
  H2 [label="base_lt_stageHyperLift"];
  DH1 [label="diagonalHyperLift_preservesGoodLifts"];
  DH2 [label="diagonalHyperLift_strictlyLiftInflationary"];
  R [label="diagonalHyperLift_rank_lt_succ"];

  B [label="baseLift20_good"];
