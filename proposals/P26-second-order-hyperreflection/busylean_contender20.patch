@@ -0,0 +1,74 @@
+import BusyLean.Contender20
+import BusyLean.SecondOrderReflectionFacts
+import BusyLean.Comparison19
+
+/-! # Contender 20: comparison theorems -/
+
+namespace BusyLean
+
+open BusyLean.W
+
+/-- The embedded first-order diagonal lift has both properties required by the
+second-order hierarchy. -/
+theorem baseLift20_good (n : Nat) : GoodLift (baseLift20 n) :=
+  ⟨diagonalLift_preservesProgressive (schedule20 n) (rank20 n),
+    diagonalLift_strictlyInflationary (schedule20 n) (rank20 n)⟩
+
+/-- The embedded first-order transformer is progressive. -/
+theorem firstOrderTransformer20_progressive (n : Nat) :
+    Progressive (baseLift20 n lTransformer) :=
+  (baseLift20_good n).1 lTransformer lTransformer_progressive
+
+/-- The complete predecessor family is below the embedded first-order layer. -/
+theorem family19_lt_firstOrder20 (n : Nat) :
+    family19 n < firstOrder20 n :=
+  firstOrderTransformer20_progressive n
+    (fun _ => family19) 0 n n (Nat.zero_le n)
+
+/-- The second-order hierarchy maps the embedded first-order lift to a good
+lift. -/
+theorem hyperLift20_good (n : Nat) :
+    GoodLift
+      (diagonalHyperLift (schedule20 n) (rank20 n) (baseLift20 n)) :=
+  (diagonalHyperLift_preservesGoodLifts (schedule20 n) (rank20 n))
+    (baseLift20 n) (baseLift20_good n)
+
+/-- The second-order transformer used by `F20` is progressive. -/
+theorem secondOrderTransformer20_progressive (n : Nat) :
+    Progressive
+      (diagonalHyperLift (schedule20 n) (rank20 n)
+        (baseLift20 n) lTransformer) :=
+  (hyperLift20_good n).1 lTransformer lTransformer_progressive
+
+/-- The full embedded first-order layer is strictly below `F20`. -/
+theorem firstOrder20_lt_F20 (n : Nat) : firstOrder20 n < F20 n :=
+  (diagonalHyperLift_strictlyLiftInflationary
+      (schedule20 n) (rank20 n))
+    (baseLift20 n) (baseLift20_good n)
+    lTransformer lTransformer_progressive
+    (fun _ => family19) n n n (Nat.le_refl n)
+
+/-- At every input, `F20` strictly exceeds Contender 19's entire family, with a
+formal intermediate witness consisting of a complete first-order diagonal
+layer. -/
+theorem family19_lt_F20 (n : Nat) : family19 n < F20 n :=
+  Nat.lt_trans (family19_lt_firstOrder20 n) (firstOrder20_lt_F20 n)
+
+/-- Every input is below Contender 19's family. -/
+theorem input_lt_family19 (n : Nat) : n < family19 n :=
+  Nat.lt_trans (input_lt_F19 n) (input_lt_F19 (F19 n))
+
+/-- Every input is below the new family. -/
+theorem input_lt_F20 (n : Nat) : n < F20 n :=
+  Nat.lt_trans (input_lt_family19 n) (family19_lt_F20 n)
+
+/-- **The required comparison:** Contender 19 is strictly smaller than
+Contender 20. -/
+theorem contender_19_lt_contender_20 : contender_19 < contender_20 :=
+  Nat.lt_trans (family19_lt_F20 42) (input_lt_F20 (F20 42))
+
+/-- A convenience corollary for the preceding accepted contender. -/
+theorem contender_18_lt_contender_20 : contender_18 < contender_20 :=
+  Nat.lt_trans contender_18_lt_contender_19 contender_19_lt_contender_20
+
+end BusyLean
diff -ruN a/BusyLean/Contender20.lean b/BusyLean/Contender20.lean
--- a/BusyLean/Contender20.lean	1970-01-01 00:00:00.000000000 +0000
+++ b/BusyLean/Contender20.lean	2026-10-13 15:41:08.846682577 +0000
@@ -0,0 +1,63 @@
+import BusyLean.SecondOrderReflection
+import BusyLean.Contender19
+
+/-!
+# Contender 20: second-order diagonal hyperreflection
+
+```
+family19 n    := F19 (F19 n)
+schedule20 n  := hyper (family19 n + 42) above schedule19 n
+rank20 n      := family19 n + 1
+baseLift20 n  := diagonalLift (schedule20 n) (rank20 n)
+firstOrder20 n := baseLift20 n lTransformer (fun _ => family19) n n
+F20 n         := diagonalHyperLift (schedule20 n) (rank20 n)
+                   (baseLift20 n) lTransformer (fun _ => family19) n n
+contender_20  := F20 (F20 42)
+```
+
+Contender 19 diagonalizes a hierarchy of transformer lifts. Contender 20 makes
+the next type-level jump: it diagonalizes hyperlifts, which act on complete
+transformer-lift hierarchies. At each input, the construction first builds a
+full first-order diagonal layer of predecessor-sized rank, then places that
+layer inside a second-order diagonal hierarchy of the same predecessor-sized
+rank. The schedule is an `Autonomous.hyper` closure constructed from
+Contender 19's own schedule syntax.
+
+**Do not evaluate `contender_20`.**
+-/
+
+namespace BusyLean
+
+open BigNumber (WTree)
+open BusyLean.W
+
+/-- Contender 19 as a family: `family19 42 = contender_19`. -/
+def family19 (n : Nat) : Nat := F19 (F19 n)
+
+/-- A predecessor-sized autonomous hyper-closure constructed from
+Contender 19's schedule syntax. No semantic tree ordering is needed. -/
+def schedule20 (n : Nat) : WTree Nat :=
+  Autonomous.realize
+    (Autonomous.hyper (family19 n + 42) (Autonomous.encode (schedule19 n)))
+
+/-- Both reflection orders are indexed by a number exceeding the complete
+predecessor family at the same input. -/
+def rank20 (n : Nat) : Nat := family19 n + 1
+
+/-- The first-order diagonal lift embedded as the base of the new hierarchy. -/
+def baseLift20 (n : Nat) : TransformerLift :=
+  diagonalLift (schedule20 n) (rank20 n)
+
+/-- The complete first-order layer contained inside `F20 n`. -/
+def firstOrder20 (n : Nat) : Nat :=
+  baseLift20 n lTransformer (fun _ => family19) n n
+
+/-- Second-order diagonal hyperreflection, seeded with Contender 19's family. -/
+def F20 (n : Nat) : Nat :=
+  diagonalHyperLift (schedule20 n) (rank20 n)
+    (baseLift20 n) lTransformer (fun _ => family19) n n
+
+/-- **Contender 20.** Never evaluate it. -/
+def contender_20 : Nat := F20 (F20 42)
+
+end BusyLean
diff -ruN a/BusyLean/SecondOrderReflection.lean b/BusyLean/SecondOrderReflection.lean
--- a/BusyLean/SecondOrderReflection.lean	1970-01-01 00:00:00.000000000 +0000
+++ b/BusyLean/SecondOrderReflection.lean	2026-10-13 15:41:08.846731681 +0000
@@ -0,0 +1,67 @@
+import BusyLean.HyperReflection
+
+/-!
+# Second-order diagonal hyperreflection
+
+`HyperReflection` raises reflection from families to transformers and then to
+transformer lifts. This module raises the construction one more type level.
+
+A `HyperLift` maps transformer lifts to transformer lifts. The pointwise splice
+`spliceLifts` makes a countable family of lifts dynamically selectable through
+the output coordinate. `stageHyperLift` traverses a W-tree using an arbitrary
+hyperlift. The base second-order operation `liftLift` applies a lift to its base
+transformer and then closes the resulting transformer under the same lift along
+the universal index. Finally, `diagonalHyperLift` repeats the diagonal pattern:
+at successor rank, the preceding rank is used both as the local hyperlift and
+as the first amplification of the base lift.
+
+Every definition is structural and executable. There is no use of
+`noncomputable`, `partial`, `unsafe`, `opaque`, `implemented_by`, or `extern`.
+-/
+
+namespace BusyLean
+
+open BigNumber (WTree)
+open BusyLean.W
+
+/-- A second-order lift acts on transformer lifts. -/
+abbrev HyperLift := TransformerLift → TransformerLift
+
+/-- Assemble countably many transformer lifts into one lift.
+
+After a base transformer is supplied, output coordinate `i` selects lift `i`.
+The selected transformer's canonical output coordinate is `0`, exactly as in
+`spliceTransformers`. -/
+def spliceLifts (ops : Nat → TransformerLift) : TransformerLift :=
+  fun base => spliceTransformers (fun i => ops i base)
+
+/-- Traverse a W-tree using an arbitrary hyperlift.
+
+At a leaf, apply the hyperlift once. At a node, recursively construct one lift
+for each child, splice those lifts, and apply the hyperlift to the splice. -/
+def stageHyperLift (hyper : HyperLift) (base : TransformerLift) :
+    WTree Nat → TransformerLift
+  | .leaf => hyper base
+  | .node f =>
+      hyper (spliceLifts (fun i => stageHyperLift hyper base (f i)))
+
+/-- The autonomous second-order lift.
+
+For a lift `L` and a base transformer `T`, first form `L T`; then traverse the
+universal index using `L` locally, with `L T` as the stage base. The occurrence
+of `L` in both positions is the second-order analogue of the diagonal seed used
+by `diagonalLift` at successor rank. -/
+def liftLift (lift : TransformerLift) : TransformerLift :=
+  fun base => stageLift lift (lift base) index
+
+/-- A diagonal hierarchy of hyperlifts over a fixed schedule.
+
+Rank zero is `liftLift`. At rank `k+1`, rank `k` is used both as the local
+hyperlift at every node of the schedule and to pre-amplify the base lift. -/
+def diagonalHyperLift (schedule : WTree Nat) : Nat → HyperLift
+  | 0, base => liftLift base
+  | k + 1, base =>
+      stageHyperLift (diagonalHyperLift schedule k)
+        (diagonalHyperLift schedule k base) schedule
+
+end BusyLean
diff -ruN a/BusyLean/SecondOrderReflectionFacts.lean b/BusyLean/SecondOrderReflectionFacts.lean
--- a/BusyLean/SecondOrderReflectionFacts.lean	1970-01-01 00:00:00.000000000 +0000
+++ b/BusyLean/SecondOrderReflectionFacts.lean	2026-10-13 15:41:08.846837971 +0000
@@ -0,0 +1,184 @@
+import BusyLean.SecondOrderReflection
+import BusyLean.HyperReflectionFacts
+
+/-!
+# Growth facts for second-order diagonal hyperreflection
+
+The proof discipline is the same as in `HyperReflectionFacts`: no monotonicity
+in an oracle family is assumed. Reflection languages may inspect oracle values,
+so such monotonicity is generally false. Every strict inequality follows an
+explicit occurrence of a base lift or a selected child lift.
+-/
+
+namespace BusyLean
+
+open BigNumber (WTree)
+open BusyLean.W
+
+/-- A good transformer lift preserves progressive transformers and strictly
+exceeds its input transformer at every visible coordinate. -/
+def GoodLift (lift : TransformerLift) : Prop :=
+  PreservesProgressive lift ∧ StrictlyInflationary lift
+
+/-- A hyperlift preserves the class of good transformer lifts. -/
+def PreservesGoodLifts (hyper : HyperLift) : Prop :=
+  ∀ (lift : TransformerLift), GoodLift lift → GoodLift (hyper lift)
+
+/-- A hyperlift strictly exceeds its input lift after both are applied to the
+same progressive base transformer. -/
+def StrictlyLiftInflationary (hyper : HyperLift) : Prop :=
+  ∀ (lift : TransformerLift), GoodLift lift →
+    ∀ (base : Transformer), Progressive base →
+      ∀ (seed : Family) (i o n : Nat), i ≤ n →
+        lift base seed i n < hyper lift base seed o n
+
+/-- Pointwise splicing preserves the progressivity-preservation property. -/
+theorem spliceLifts_preservesProgressive {ops : Nat → TransformerLift}
+    (hops : ∀ i, PreservesProgressive (ops i)) :
+    PreservesProgressive (spliceLifts ops) := by
+  intro base hbase
+  exact spliceTransformers_progressive (fun i => hops i base hbase)
+
+/-- Pointwise splicing preserves strict inflationarity. -/
+theorem spliceLifts_strictlyInflationary {ops : Nat → TransformerLift}
+    (hops : ∀ i, StrictlyInflationary (ops i)) :
+    StrictlyInflationary (spliceLifts ops) := by
+  intro base hbase seed i o n hi
+  change base seed i n < ops o base seed 0 n
+  exact hops o base hbase seed i 0 n hi
+
+/-- A splice of good lifts is good. -/
+theorem spliceLifts_good {ops : Nat → TransformerLift}
+    (hops : ∀ i, GoodLift (ops i)) :
+    GoodLift (spliceLifts ops) :=
+  ⟨spliceLifts_preservesProgressive (fun i => (hops i).1),
+    spliceLifts_strictlyInflationary (fun i => (hops i).2)⟩
+
+/-- The autonomous second-order lift preserves goodness. -/
+theorem liftLift_preservesGoodLifts : PreservesGoodLifts liftLift := by
+  intro lift hlift
+  constructor
+  · intro base hbase
+    exact stageLift_progressive lift hlift.1 (lift base)
+      (hlift.1 base hbase) index
+  · intro base hbase seed i o n hi
+    have hfirst : base seed i n < lift base seed i n :=
+      hlift.2 base hbase seed i i n hi
+    have hsecond :
+        lift base seed i n < stageLift lift (lift base) index seed o n :=
+      base_lt_stageLift lift hlift.1 hlift.2
+        (lift base) (hlift.1 base hbase) index seed i o n hi
+    exact Nat.lt_trans hfirst hsecond
+
+/-- The autonomous second-order lift strictly exceeds its input lift. -/
+theorem liftLift_strictlyLiftInflationary :
+    StrictlyLiftInflationary liftLift := by
+  intro lift hlift base hbase seed i o n hi
+  exact base_lt_stageLift lift hlift.1 hlift.2
+    (lift base) (hlift.1 base hbase) index seed i o n hi
+
+/-- A hyperlift tree stage is good whenever its local hyperlift preserves good
+lifts and its base lift is good. -/
+theorem stageHyperLift_good (hyper : HyperLift)
+    (hhyper : PreservesGoodLifts hyper)
+    (base : TransformerLift) (hbase : GoodLift base) :
+    (a : WTree Nat) → GoodLift (stageHyperLift hyper base a)
+  | .leaf => hhyper base hbase
+  | .node f => by
+      apply hhyper
+      exact spliceLifts_good
+        (fun i => stageHyperLift_good hyper hhyper base hbase (f i))
+
+/-- If a hyperlift is strict, then every tree stage strictly exceeds its base
+lift. The node case follows child zero and then uses that child as coordinate
+zero of the splice. -/
+theorem base_lt_stageHyperLift (hyper : HyperLift)
+    (hpres : PreservesGoodLifts hyper)
+    (hstrict : StrictlyLiftInflationary hyper)
+    (base : TransformerLift) (hbase : GoodLift base) :
+    (a : WTree Nat) →
+      ∀ (op : Transformer), Progressive op →
+        ∀ (seed : Family) (i o n : Nat), i ≤ n →
+          base op seed i n < stageHyperLift hyper base a op seed o n
+  | .leaf, op, hop, seed, i, o, n, hi =>
+      hstrict base hbase op hop seed i o n hi
+  | .node f, op, hop, seed, i, o, n, hi => by
+      have hchild :
+          base op seed i n <
+            stageHyperLift hyper base (f 0) op seed 0 n :=
+        base_lt_stageHyperLift hyper hpres hstrict base hbase
+          (f 0) op hop seed i 0 n hi
+      have hsplice : GoodLift
+          (spliceLifts (fun j => stageHyperLift hyper base (f j))) :=
+        spliceLifts_good
+          (fun j => stageHyperLift_good hyper hpres base hbase (f j))
+      have hparent :
+          stageHyperLift hyper base (f 0) op seed 0 n <
+            stageHyperLift hyper base (.node f) op seed o n := by
+        change
+          spliceLifts (fun j => stageHyperLift hyper base (f j))
+                op seed 0 n <
+            hyper (spliceLifts (fun j => stageHyperLift hyper base (f j)))
+                op seed o n
+        exact hstrict
+          (spliceLifts (fun j => stageHyperLift hyper base (f j)))
+          hsplice op hop seed 0 o n (Nat.zero_le n)
+      exact Nat.lt_trans hchild hparent
+
+/-- Every second-order diagonal rank preserves goodness. -/
+theorem diagonalHyperLift_preservesGoodLifts (schedule : WTree Nat) :
+    ∀ k, PreservesGoodLifts (diagonalHyperLift schedule k)
+  | 0 => liftLift_preservesGoodLifts
+  | k + 1 => by
+      intro base hbase
+      exact stageHyperLift_good
+        (diagonalHyperLift schedule k)
+        (diagonalHyperLift_preservesGoodLifts schedule k)
+        (diagonalHyperLift schedule k base)
+        ((diagonalHyperLift_preservesGoodLifts schedule k) base hbase)
+        schedule
+
+/-- Every second-order diagonal rank strictly exceeds its original base lift. -/
+theorem diagonalHyperLift_strictlyLiftInflationary
+    (schedule : WTree Nat) :
+    ∀ k, StrictlyLiftInflationary (diagonalHyperLift schedule k)
+  | 0 => liftLift_strictlyLiftInflationary
+  | k + 1 => by
+      intro base hbase op hop seed i o n hi
+      have hfirst :
+          base op seed i n <
+            diagonalHyperLift schedule k base op seed i n :=
+        (diagonalHyperLift_strictlyLiftInflationary schedule k)
+          base hbase op hop seed i i n hi
+      have hbase' : GoodLift (diagonalHyperLift schedule k base) :=
+        (diagonalHyperLift_preservesGoodLifts schedule k) base hbase
+      have hsecond :
+          diagonalHyperLift schedule k base op seed i n <
+            stageHyperLift (diagonalHyperLift schedule k)
+              (diagonalHyperLift schedule k base) schedule
+              op seed o n :=
+        base_lt_stageHyperLift
+          (diagonalHyperLift schedule k)
+          (diagonalHyperLift_preservesGoodLifts schedule k)
+          (diagonalHyperLift_strictlyLiftInflationary schedule k)
+          (diagonalHyperLift schedule k base) hbase'
+          schedule op hop seed i o n hi
+      exact Nat.lt_trans hfirst hsecond
+
+/-- The second-order hierarchy is strictly increasing rank by rank. -/
+theorem diagonalHyperLift_rank_lt_succ (schedule : WTree Nat) (k : Nat)
+    (base : TransformerLift) (hbase : GoodLift base)
+    (op : Transformer) (hop : Progressive op)
+    (seed : Family) (i o n : Nat) (hi : i ≤ n) :
+    diagonalHyperLift schedule k base op seed i n <
+      diagonalHyperLift schedule (k + 1) base op seed o n := by
+  have hbase' : GoodLift (diagonalHyperLift schedule k base) :=
+    (diagonalHyperLift_preservesGoodLifts schedule k) base hbase
+  exact base_lt_stageHyperLift
+    (diagonalHyperLift schedule k)
+    (diagonalHyperLift_preservesGoodLifts schedule k)
+    (diagonalHyperLift_strictlyLiftInflationary schedule k)
+    (diagonalHyperLift schedule k base) hbase'
+    schedule op hop seed i o n hi
+
+end BusyLean
