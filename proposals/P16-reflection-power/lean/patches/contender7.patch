--- /dev/null
+++ b/BusyLean/Contender7.lean
@@ -0,0 +1,50 @@
+import BusyLean.Contender6
+
+/-!
+# Contender 7: seeded reflection power
+
+The current `stage` scheduler performs forest reflection through a `WTree Nat`.
+`liftStage` promotes an arbitrary scheduler `S` by using a second W-tree as an
+operator-level control object.  A leaf runs `S` through the universal `index`;
+a node feeds the promoted values of all children back to `S` as its oracle
+family, again at `index`.
+
+`stageOrder k` iterates this promotion `k` times.  The final height is the P5
+seed value at 42, plus a fixed positive guard.  The definition does not use the
+value `BusyLean.contender_6` as an iteration counter.
+
+Do not evaluate `contender_7`.
+-/
+
+namespace BusyLean
+
+open BigNumber (WTree)
+open BusyLean.W
+
+/-- A forest-reflection scheduler: oracle family, control tree, input. -/
+abbrev StageOperator := Family → WTree Nat → Nat → Nat
+
+/-- Raise a scheduler by one reflection order.
+
+At a leaf, run `S` with the supplied seed through the universal index.  At a
+node, recursively promote every child and expose the resulting family to `S`.
+All recursion is structural recursion on the W-tree. -/
+def liftStage (S : StageOperator) (seed : Family) : WTree Nat → Nat → Nat
+  | .leaf => S seed index
+  | .node f => S (fun i => liftStage S seed (f i)) index
+
+/-- The finite hierarchy of scheduler orders. -/
+def stageOrder : Nat → StageOperator
+  | 0 => stage
+  | k + 1 => liftStage (stageOrder k)
+
+/-- A large, closed, computable promotion height.
+
+The successor guard makes positivity definitional, so the comparison proof
+never needs to normalize the P5 value. -/
+def metaHeight : Nat := Nat.succ (42 + p5Family 0 42)
+
+/-- **Contender 7.**  Never evaluate it. -/
+def contender_7 : Nat := stageOrder metaHeight p5Family index 42
+
+end BusyLean
diff --git a/test/Contender7Audit.lean b/test/Contender7Audit.lean
new file mode 100644
index 0000000000000000000000000000000000000000..5f23a5367c6cb95a49944996c1838dca981af97c
--- /dev/null
+++ b/test/Contender7Audit.lean
@@ -0,0 +1,58 @@
+import BusyLean
+import Lean
+
+/-!
+# Contender 7 kernel audit
+
+Run with `lake env lean test/Contender7Audit.lean` after installing the overlay.
+It prints axioms, proves that the new number's defining closure does not contain
+any incumbent contender value, and records the comparison theorem signatures.
+-/
+
+open Lean Elab Command
+
+/-- All constants reachable from `root` through declaration types and values. -/
+def contender7ConstClosure (env : Environment) (root : Name) : NameSet := Id.run do
+  let mut seen : NameSet := {}
+  let mut stack := #[root]
+  while stack.size > 0 do
+    let c := stack.back!
+    stack := stack.pop
+    if seen.contains c then continue
+    seen := seen.insert c
+    let some ci := env.find? c | continue
+    let body : Array Name := match ci with
+      | .defnInfo v => v.value.getUsedConstants
+      | .thmInfo v => v.value.getUsedConstants
+      | .opaqueInfo v => v.value.getUsedConstants
+      | _ => #[]
+    stack := stack ++ ci.type.getUsedConstants ++ body
+  return seen
+
+/-- Fail if any listed constant occurs in the closure of the first one. -/
+elab "#assert_not_in_contender7_closure " root:ident " : " bad:ident* : command => do
+  let env ← getEnv
+  let r ← liftCoreM <| realizeGlobalConstNoOverloadWithInfo root
+  let cl := contender7ConstClosure env r
+  for b in bad do
+    let n ← liftCoreM <| realizeGlobalConstNoOverloadWithInfo b
+    if cl.contains n then throwError m!"{r} depends on forbidden constant {n}"
+  logInfo m!"{r}: closure of {cl.size} constants avoids all {bad.size} forbidden names"
+
+#print axioms BusyLean.contender_7
+#print axioms BusyLean.contender_6_lt_contender_7
+#print axioms BusyLean.contender_5_lt_contender_7
+#print axioms BusyLean.p5_lt_contender_7
+#print axioms BusyLean.stageOrder_indexDominates
+
+-- The construction reuses the incumbent language and seed, but not any named
+-- incumbent value as an iteration counter or hidden subterm.
+#assert_not_in_contender7_closure BusyLean.contender_7 :
+  BusyLean.contender_6 BusyLean.contender_5
+  BigNumber.contender_6 BigNumber.contender_5
+
+#check @BusyLean.contender_6_lt_contender_7
+#check @BusyLean.contender_5_lt_contender_7
+#check @BusyLean.p5_lt_contender_7
+#check @BusyLean.stageOrder_step
+#check @BusyLean.stageOrder_indexDominates
