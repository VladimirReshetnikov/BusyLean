@@ -0,0 +1,58 @@
+import BusyLean.Comparison14
+import Lean
+
+/-!
+# Contender 14 audit
+
+Run with `lake env lean test/Audit14.lean` after copying the two source modules
+into the BusyLean repository.  It checks axioms and verifies that the new
+number's definition does not depend on any earlier contender constant.
+-/
+
+open Lean Elab Command
+
+/-- All constants reachable from `root` through declaration types and values. -/
+def constClosure14 (env : Environment) (root : Name) : NameSet := Id.run do
+  let mut seen : NameSet := {}
+  let mut stack := #[root]
+  while stack.size > 0 do
+    let c := stack.back!
+    stack := stack.pop
+    if seen.contains c then continue
+    seen := seen.insert c
+    let some ci := env.find? c | continue
+    let body : Array Name := match ci with
+      | .defnInfo v => v.value.getUsedConstants
+      | .thmInfo v => v.value.getUsedConstants
+      | .opaqueInfo v => v.value.getUsedConstants
+      | _ => #[]
+    stack := stack ++ ci.type.getUsedConstants ++ body
+  return seen
+
+/-- Fail if any listed constant belongs to the transitive closure of `root`. -/
+elab "#assert_not_in_closure14 " root:ident " : " bad:ident* : command => do
+  let env ← getEnv
+  let r ← liftCoreM <| realizeGlobalConstNoOverloadWithInfo root
+  let cl := constClosure14 env r
+  for b in bad do
+    let n ← liftCoreM <| realizeGlobalConstNoOverloadWithInfo b
+    if cl.contains n then
+      throwError m!"{r} depends on forbidden constant {n}"
+  logInfo m!"{r}: closure of {cl.size} constants avoids all forbidden names"
+
+#print axioms BusyLean.contender_14
+#print axioms BusyLean.contender_13_lt_contender_14
+#print axioms BusyLean.family13_lt_F14
+#print axioms BusyLean.family13_twice_lt_F14
+#print axioms BusyLean.fvalue_lt_F14
+#print axioms BusyLean.operatorPower_progressive
+#print axioms BusyLean.operatorPower_step_lt
+
+#assert_not_in_closure14 BusyLean.contender_14 :
+  BusyLean.contender_13 BusyLean.contender_12 BusyLean.contender_11
+  BusyLean.contender_10 BusyLean.contender_9 BusyLean.contender_8
+  BusyLean.contender_7 BusyLean.contender_6 BusyLean.contender_5
+
+#check @BusyLean.contender_13_lt_contender_14
+#check @BusyLean.fvalue_lt_F14
+#check @BusyLean.operatorPower_step_lt
diff --git a/scripts/check14.py b/scripts/check14.py
new file mode 100755
index 0000000..8b2f0db
--- /dev/null
+++ b/scripts/check14.py
@@ -0,0 +1,92 @@
+#!/usr/bin/env python3
+"""Clean-build and audit the Contender 14 overlay.
+
+Copy BusyLean/Contender14.lean, BusyLean/Comparison14.lean and
+ test/Audit14.lean into a checkout of BusyLean, then run from the repository
+root:
+
+    python3 scripts/check14.py
+"""
+from __future__ import annotations
+
+import re
+import shutil
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+BUILD_DIRS = [
+    ROOT / ".lake" / "build",
+    ROOT / "proposals" / "P5-w-reflection" / "lean" / ".lake" / "build",
+]
+PERMITTED = {"propext", "Quot.sound"}
+PREVIOUS = "BusyLean.Comparison13"
+CURRENT_DEF = "BusyLean.Contender14"
+CURRENT_PROOF = "BusyLean.Comparison14"
+DEFINITION_BUDGET = 15.0
+PROOF_BUDGET = 60.0
+LAKE = shutil.which("lake")
+
+
+def run(args: list[str]) -> subprocess.CompletedProcess[str]:
+    if LAKE is None:
+        raise SystemExit(
+            "FAIL: `lake` was not found. Install the repository-pinned "
+            "Lean toolchain before running this audit."
+        )
+    return subprocess.run(
+        [LAKE, *args], cwd=ROOT, capture_output=True, text=True, check=False
+    )
+
+
+def timed_build(label: str, targets: list[str], budget: float | None) -> float:
+    start = time.monotonic()
+    result = run(["build", *targets])
+    elapsed = time.monotonic() - start
+    if result.returncode != 0:
+        print(result.stdout, result.stderr)
+        raise SystemExit(f"FAIL: {label} build failed")
+    suffix = f"budget {budget:.0f} s" if budget else "accepted earlier"
+    print(f"{label}: {elapsed:.2f} s ({suffix})")
+    if budget is not None and elapsed > budget:
+        raise SystemExit(f"FAIL: {label} exceeded its budget")
+    return elapsed
+
+
+def main() -> None:
+    for directory in BUILD_DIRS:
+        shutil.rmtree(directory, ignore_errors=True)
+
+    total = timed_build("previous contender", [PREVIOUS], None)
+    total += timed_build("definitions", [CURRENT_DEF], DEFINITION_BUDGET)
+    total += timed_build("proofs", [CURRENT_PROOF], PROOF_BUDGET)
+    print(f"total clean build: {total:.2f} s")
+
+    audit = run(["env", "lean", "test/Audit14.lean"])
+    output = audit.stdout + audit.stderr
+    print(output)
+    if audit.returncode != 0:
+        raise SystemExit("FAIL: audit did not run cleanly")
+
+    reports = re.findall(
+        r"'([^']+)' (?:depends on axioms: \[([^\]]*)\]|does not depend)",
+        output,
+    )
+    bad = [
+        (name, axioms)
+        for name, axioms in reports
+        if axioms
+        and set(a.strip() for a in axioms.split(",")) - PERMITTED
+    ]
+    if not reports or bad:
+        raise SystemExit(f"FAIL: forbidden axioms or no reports: {bad}")
+    print(
+        f"PASS: {len(reports)} declarations audited; "
+        f"axioms within {sorted(PERMITTED)}"
+    )
+
+
+if __name__ == "__main__":
+    main()
