+import BusyLean.Contender7
+import BusyLean.MetaReflectionFacts
+import BusyLean.Comparison
+
+/-!
+# Contender 7: comparison theorems
+
+The required theorem is `contender_6_lt_contender_7`.  The proof does not use
+monotonicity.  It exposes Contender 6 as the leaf operator and then follows two
+visible child edges through the outer universal index.
+-/
+
+namespace BusyLean
+
+open BigNumber (Term)
+open BusyLean.W
+
+/-- At every input, the autonomous operator family strictly exceeds the entire
+Contender-6 family. -/
+theorem finalFamily_lt_autonomousFamily (n : Nat) :
+    finalFamily n < autonomousFamily n n := by
+  have h0 :
+      operatorStage reflectionTransformer .leaf p5Family 0 n <
+        operatorStage reflectionTransformer (treesOfDepth 0) p5Family 0 n := by
+    have h := operatorStage_child_lt reflectionTransformer
+      reflectionTransformer_progressive p5Family
+      (fun i => defTree (nthD (BigNumber.allTerms 0) i .zero))
+      (i := 0) (o := 0) (n := n) (Nat.zero_le n)
+    rw [depthZeroTreeLeaf] at h
+    exact h
+  have h1 :
+      operatorStage reflectionTransformer (treesOfDepth 0) p5Family 0 n <
+        operatorStage reflectionTransformer index p5Family n n :=
+    operatorStage_child_lt reflectionTransformer
+      reflectionTransformer_progressive p5Family treesOfDepth
+      (i := 0) (o := n) (n := n) (Nat.zero_le n)
+  have h :
+      liftTransformer reflectionTransformer p5Family 0 n <
+        operatorStage reflectionTransformer index p5Family n n :=
+    Nat.lt_trans h0 h1
+  change stage p5Family index n <
+    operatorStage reflectionTransformer index p5Family n n
+  rw [← liftReflection_eq_stage p5Family 0 n]
+  exact h
+
+/-- **The required comparison:** Contender 6 is strictly below Contender 7. -/
+theorem contender_6_lt_contender_7 : contender_6 < contender_7 :=
+  finalFamily_lt_autonomousFamily 42
+
+/-- Hence the exact Lean port of Contender 5 is also strictly below
+Contender 7. -/
+theorem contender_5_lt_contender_7 : contender_5 < contender_7 :=
+  Nat.lt_trans contender_5_lt_contender_6 contender_6_lt_contender_7
+
+/-- Proposal P5's number is strictly below Contender 7. -/
+theorem p5_lt_contender_7 : BigNumber.contender_6 < contender_7 :=
+  Nat.lt_trans p5_lt_contender_6 contender_6_lt_contender_7
+
+/-- Every operator-stage generated by a visible defined tree is strictly below
+the final autonomous family. -/
+theorem defined_operator_lt_autonomousFamily {k i n : Nat}
+    (hk : k ≤ n) (hi : i ≤ n) :
+    operatorStage reflectionTransformer
+        (defTree (nthD (BigNumber.allTerms k) i .zero)) p5Family 0 n <
+      autonomousFamily n n := by
+  have h1 :
+      operatorStage reflectionTransformer
+          (defTree (nthD (BigNumber.allTerms k) i .zero)) p5Family 0 n <
+        operatorStage reflectionTransformer (treesOfDepth k) p5Family 0 n :=
+    operatorStage_child_lt reflectionTransformer
+      reflectionTransformer_progressive p5Family
+      (fun j => defTree (nthD (BigNumber.allTerms k) j .zero))
+      (i := i) (o := 0) (n := n) hi
+  have h2 :
+      operatorStage reflectionTransformer (treesOfDepth k) p5Family 0 n <
+        operatorStage reflectionTransformer index p5Family n n :=
+    operatorStage_child_lt reflectionTransformer
+      reflectionTransformer_progressive p5Family treesOfDepth
+      (i := k) (o := n) (n := n) hk
+  exact Nat.lt_trans h1 h2
+
+/-- Every tree defined by the W-language gives an operator-stage that is
+(eventually, at its canonical output coordinate) dominated by Contender 7's
+family. -/
+theorem defined_operator_eventually_lt {k : Nat} {t : Term}
+    (ht : t ∈ BigNumber.allTerms k) :
+    ∃ N, ∀ n, N ≤ n →
+      operatorStage reflectionTransformer (defTree t) p5Family 0 n <
+        autonomousFamily n n := by
+  obtain ⟨i, hi⟩ := exists_nthD_of_mem (d := Term.zero) ht
+  refine ⟨k + i, fun n hn => ?_⟩
+  rw [← hi]
+  exact defined_operator_lt_autonomousFamily
+    (Nat.le_trans (Nat.le_add_right k i) hn)
+    (Nat.le_trans (Nat.le_add_left i k) hn)
+
+end BusyLean
