@@ -0,0 +1,88 @@
+#!/usr/bin/env python3
+"""Reproducible kernel, timing, smoke, and axiom checks after integration."""
+from __future__ import annotations
+
+import re
+import shutil
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+# When copied into the BusyLean repository, ROOT is the repository root.
+if not (ROOT / "lakefile.toml").exists():
+    candidate = ROOT / "repo_overlay"
+    if (candidate / "BusyLean").exists():
+        sys.exit(
+            "Copy the overlay into a BusyLean checkout, then place this script "
+            "under scripts/ and run it from there."
+        )
+
+BUILD_DIRS = [
+    ROOT / ".lake" / "build",
+    ROOT / "proposals" / "P5-w-reflection" / "lean" / ".lake" / "build",
+]
+PERMITTED = {"propext", "Quot.sound"}
+DEFINITION_BUDGET = 15.0
+PROOF_BUDGET = 60.0
+LAKE = shutil.which("lake") or "lake"
+
+
+def run(args: list[str]) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        [LAKE, *args], cwd=ROOT, capture_output=True, text=True
+    )
+
+
+def timed(label: str, target: list[str], budget: float) -> None:
+    start = time.monotonic()
+    proc = run(["build", *target])
+    elapsed = time.monotonic() - start
+    if proc.returncode != 0:
+        print(proc.stdout, proc.stderr)
+        sys.exit(f"FAIL: {label} build failed")
+    print(f"{label}: {elapsed:.1f} s (budget {budget:.0f} s)")
+    if elapsed > budget:
+        sys.exit(f"FAIL: {label} exceeded the budget")
+
+
+def main() -> None:
+    for directory in BUILD_DIRS:
+        shutil.rmtree(directory, ignore_errors=True)
+
+    timed("definitions", ["BusyLean.Contender7"], DEFINITION_BUDGET)
+    timed("proofs", [], PROOF_BUDGET)
+
+    smoke = run(["env", "lean", "test/MetaReflectionSmoke.lean"])
+    print(smoke.stdout + smoke.stderr)
+    if smoke.returncode != 0:
+        sys.exit("FAIL: MetaReflectionSmoke did not run cleanly")
+
+    audit = run(["env", "lean", "test/Contender7Audit.lean"])
+    output = audit.stdout + audit.stderr
+    print(output)
+    if audit.returncode != 0:
+        sys.exit("FAIL: Contender7Audit did not run cleanly")
+
+    reports = re.findall(
+        r"'([^']+)' (?:depends on axioms: \[([^\]]*)\]|does not depend)",
+        output,
+    )
+    bad = [
+        (name, axioms)
+        for name, axioms in reports
+        if axioms
+        and set(a.strip() for a in axioms.split(",")) - PERMITTED
+    ]
+    if not reports or bad:
+        sys.exit(f"FAIL: forbidden axioms or missing reports: {bad}")
+
+    print(
+        f"PASS: {len(reports)} declarations audited; "
+        f"axioms within {sorted(PERMITTED)}"
+    )
+
+
+if __name__ == "__main__":
+    main()
diff --git a/test/Contender7Audit.lean b/test/Contender7Audit.lean
new file mode 100644
index 0000000..7bd6ea3
--- /dev/null
+++ b/test/Contender7Audit.lean
@@ -0,0 +1,58 @@
+import BusyLean.Comparison7
+import Lean
+
+/-!
+Run with:
+
+    lake env lean test/Contender7Audit.lean
+
+The expected axiom set is empty or a subset of `{propext, Quot.sound}`.
+The dependency audit checks the transitive kernel-environment closure, not just
+surface syntax.  Do not add `#eval BusyLean.contender_7`.
+-/
+
+open Lean Elab Command
+
+/-- All constants reachable from `root` through declaration types and values. -/
+def contender7ConstClosure (env : Environment) (root : Name) : NameSet := Id.run do
+  let mut seen : NameSet := {}
+  let mut stack := #[root]
+  while stack.size > 0 do
+    let c := stack.back!
+    stack := stack.pop
+    if seen.contains c then continue
+    seen := seen.insert c
+    let some ci := env.find? c | continue
+    let body : Array Name := match ci with
+      | .defnInfo v => v.value.getUsedConstants
+      | .thmInfo v => v.value.getUsedConstants
+      | .opaqueInfo v => v.value.getUsedConstants
+      | _ => #[]
+    stack := stack ++ ci.type.getUsedConstants ++ body
+  return seen
+
+/-- Fail if any listed declaration occurs in the transitive closure of root. -/
+elab "#assert_contender7_not_in_closure " root:ident " : " bad:ident* : command => do
+  let env ← getEnv
+  let r ← liftCoreM <| realizeGlobalConstNoOverloadWithInfo root
+  let closure := contender7ConstClosure env r
+  for b in bad do
+    let n ← liftCoreM <| realizeGlobalConstNoOverloadWithInfo b
+    if closure.contains n then
+      throwError m!"{r} depends on forbidden constant {n}"
+  logInfo m!"{r}: closure of {closure.size} constants avoids all {bad.size} forbidden names"
+
+#print axioms BusyLean.contender_7
+#print axioms BusyLean.contender_6_lt_contender_7
+#print axioms BusyLean.finalFamily_lt_autonomousFamily
+#print axioms BusyLean.defined_operator_eventually_lt
+
+#assert_contender7_not_in_closure BusyLean.contender_7 :
+  BusyLean.contender_6 BusyLean.finalFamily BusyLean.contender_5
+  BigNumber.contender_6 BigNumber.contender_5
+  BusyLean.C5.largestOfDepth BusyLean.C5.maxBy
+  BusyLean.C5.largestSTLCNatRecNatOfDepth
+
+#check @BusyLean.contender_6_lt_contender_7
+#check @BusyLean.contender_5_lt_contender_7
+#check @BusyLean.p5_lt_contender_7
diff --git a/test/MetaReflectionSmoke.lean b/test/MetaReflectionSmoke.lean
new file mode 100644
index 0000000..fbcdefc
--- /dev/null
+++ b/test/MetaReflectionSmoke.lean
@@ -0,0 +1,18 @@
+import BusyLean.MetaReflection
+
+open BusyLean
+open BusyLean.W
+open BigNumber (WTree)
+
+/-- A tiny executable transformer used only for smoke testing the recursion. -/
+def plusOneTransformer : Transformer :=
+  fun seed _ n => seed 0 n + 1
+
+private def seed : Family := fun i n => i + n
+private def oneNode : WTree Nat := .node fun _ => .leaf
+
+#eval runTransformer plusOneTransformer seed .leaf 0 2
+#eval runTransformer plusOneTransformer seed oneNode 0 2
+
+example : runTransformer plusOneTransformer seed .leaf 0 2 = 3 := rfl
+example : runTransformer plusOneTransformer seed oneNode 0 2 = 4 := rfl
