import BusyLean.Contender14
import BusyLean.Autonomous
import BusyLean.MetaReflection

/-!
# Contender 15: ramified diagonal hyperreflection

The repository's incoming Contender 14 proposal turns dynamic-kind family
reflection into a diagonal hierarchy of transformer lifts.  This module takes
that entire construction as its seed and moves one level higher again.

For input `n`:

* `family14 n = F14 (F14 n)` is the full Contender-14 construction as a family;
* `schedule15 n` applies a `family14 n`-sized autonomous derivative level above
  Contender 14's own input-dependent schedule;
* `diagonalTransformer15` performs diagonal hyperreflection at rank
  `family14 n + 1` over that enlarged schedule;
* `metaTower15` then iterates BusyLean's complete operator-stage constructor
  through the still larger height `family14 (family14 n) + 1`.

Thus the proposal is not a numerical padding of Contender 14: it uses the
previous construction as an oracle family, as the rank and schedule controller
of a new diagonal lift, and as the height of a tower of operator constructors.
All recursion is structural and the definition is computable in principle.

**Do not evaluate `contender_15`.**
-/

namespace BusyLean

open BigNumber (WTree)

/-- The full incoming Contender-14 construction as a function of its input.
Definitionally, `family14 42 = contender_14`; the named constant is not used. -/
def family14 (n : Nat) : Nat := F14 (F14 n)

/-- The constant countable oracle family generated by Contender 14. -/
def seed14 : W.Family := fun _ => family14

/-- An input-dependent schedule strictly beyond Contender 14's schedule: the
old schedule is re-indexed at `family14 n` and then placed below a
`family14 n + 42` autonomous hyper-derivative level. -/
def schedule15 (n : Nat) : WTree Nat :=
  Autonomous.realize
    (Autonomous.hyper (family14 n + 42)
      (Autonomous.encode (schedule14 (family14 n))))

/-- The diagonal hyperreflection rank used by the new base transformer. -/
def rank15 (n : Nat) : Nat := family14 n + 1

/-- A single input-sensitive diagonal-hyperreflection transformer. -/
def diagonalTransformer15 : Transformer :=
  fun fs o n =>
    diagonalLift (schedule15 n) (rank15 n) fdFamilyTransformer fs o n

/-- The number of full operator-stage successors used at input `n`. -/
def ramification15 (n : Nat) : Nat := family14 (family14 n)

/-- A fixed core schedule controlled by a twice-iterated Contender-14 value. -/
def coreTree15 : WTree Nat := schedule15 (ramification15 42)

/-- Crown a core schedule with a canonical leaf at child zero. -/
def crown15 (core : WTree Nat) : Nat → WTree Nat
  | 0 => .leaf
  | _ + 1 => core

/-- The crowned schedule used at every complete operator metastep. -/
def tree15 : WTree Nat := .node (crown15 coreTree15)

/-- One complete operator-stage successor. -/
def metaStep15 (op : Transformer) : Transformer :=
  operatorStage op tree15

/-- Iterate complete operator-stage formation through a finite metatower. -/
def metaTower15 : Nat → Transformer
  | 0 => diagonalTransformer15
  | k + 1 => metaStep15 (metaTower15 k)

/-- The pointwise Contender-15 family. -/
def F15 (n : Nat) : Nat :=
  metaTower15 (ramification15 n + 1) seed14 n n

/-- **Contender 15.** Never evaluate it. -/
def contender_15 : Nat := F15 (F15 42)

end BusyLean
