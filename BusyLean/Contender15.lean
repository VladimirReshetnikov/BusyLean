import BusyLean.Contender14
import BusyLean.Incoming14.DiagonalOperatorTower
import BusyLean.Incoming14.RDOR
import BusyLean.Incoming14.RankDiagonal
import BusyLean.Autonomous
import BusyLean.MetaReflection

/-!
# Contender 15: universal-envelope ramified diagonal hyperreflection

The current repository contains four unprocessed Contender-14 proposals.  This
module places their four pointwise closed-family analogues into one explicit
finite maximum.  The resulting envelope is then used simultaneously as

* the countable oracle seed,
* the controller of a fresh diagonal-hyperreflection rank and schedule, and
* the height controller of an outer tower of complete operator stages.

Thus the new contender is formally above every current incoming candidate,
without requiring a comparison between those candidates.

**Do not evaluate `contender_15`.**
-/

namespace BusyLean

open BigNumber (WTree)

/-- The incoming diagonal-hyperreflection candidate as a family. -/
def diagonalHyper14Family (n : Nat) : Nat := F14 (F14 n)

/-- The incoming diagonal-operator-tower candidate as a family. -/
def diagonalOperatorTower14Family (n : Nat) : Nat :=
  Incoming14.DiagonalOperatorTower.F14
    (Incoming14.DiagonalOperatorTower.F14 n)

/-- The incoming ramified dynamic operator reflection candidate as a family. -/
def rdor14Family (n : Nat) : Nat :=
  Incoming14.RDOR.F14 (Incoming14.RDOR.F14 n)

/-- The incoming rank-diagonal candidate as a family. -/
def rankDiagonal14Family (n : Nat) : Nat :=
  Incoming14.RankDiagonal.F14 (Incoming14.RankDiagonal.F14 n)

/-- Pointwise maximum of every Contender-14 family currently present in
`incoming/` at the repository snapshot used for validation. -/
def incoming14Envelope (n : Nat) : Nat :=
  BigNumber.maxN (diagonalHyper14Family n)
    (BigNumber.maxN (diagonalOperatorTower14Family n)
      (BigNumber.maxN (rdor14Family n) (rankDiagonal14Family n)))

/-- A strictly larger universal predecessor family.  The explicit `n + 1`
margin gives input growth without assuming monotonicity of any candidate. -/
def family14 (n : Nat) : Nat := incoming14Envelope n + n + 1

/-- Constant countable oracle family generated by the universal predecessor. -/
def seed14 : W.Family := fun _ => family14

/-- A fresh input-dependent schedule above the diagonal-hyperreflection
schedule, controlled by the universal predecessor family. -/
def schedule15 (n : Nat) : WTree Nat :=
  Autonomous.realize
    (Autonomous.hyper (family14 n + 42)
      (Autonomous.encode (schedule14 (family14 n))))

/-- Diagonal hyperreflection rank. -/
def rank15 (n : Nat) : Nat := family14 n + 1

/-- Input-sensitive diagonal-hyperreflection transformer. -/
def diagonalTransformer15 : Transformer :=
  fun fs o n =>
    diagonalLift (schedule15 n) (rank15 n) fdFamilyTransformer fs o n

/-- Height controller for the outer complete-operator metatower. -/
def ramification15 (n : Nat) : Nat := family14 (family14 n)

/-- Fixed large core schedule. -/
def coreTree15 : WTree Nat := schedule15 (ramification15 42)

/-- Crown a core schedule with a canonical leaf at child zero. -/
def crown15 (core : WTree Nat) : Nat → WTree Nat
  | 0 => .leaf
  | _ + 1 => core

/-- Crowned schedule used by every complete operator metastep. -/
def tree15 : WTree Nat := .node (crown15 coreTree15)

/-- One complete operator-stage successor. -/
def metaStep15 (op : Transformer) : Transformer :=
  operatorStage op tree15

/-- Outer metatower. -/
def metaTower15 : Nat → Transformer
  | 0 => diagonalTransformer15
  | k + 1 => metaStep15 (metaTower15 k)

/-- Pointwise universal-envelope Contender-15 family. -/
def F15 (n : Nat) : Nat :=
  metaTower15 (ramification15 n + 1) seed14 n n

/-- **Contender 15.** Never evaluate it. -/
def contender_15 : Nat := F15 (F15 42)

end BusyLean
