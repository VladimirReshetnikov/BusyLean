import BusyLean.Contender13
import BusyLean.Contender9
import BusyLean.Autonomous
import BusyLean.MetaReflection

/-!
# Namespaced reconstruction of bi-diagonal rank reflection

This module reproduces the executable definitions from
`BusyLean_Contender14_RankDiagonal.zip` under a private namespace.  Proofs from
that package are not needed for the universal-envelope comparison.
-/

namespace BusyLean.Incoming14.RankDiagonal

open BigNumber (WTree)

/-- An operator on family transformers. -/
abbrev MetaTransformer := BusyLean.Transformer → BusyLean.Transformer

/-- Iterate a meta-transformer along a well-founded tree. -/
def metaStage (amp : MetaTransformer) (base : BusyLean.Transformer) :
    WTree Nat → BusyLean.Transformer
  | .leaf => amp base
  | .node f =>
      amp (BusyLean.spliceTransformers
        (fun i => metaStage amp base (f i)))

/-- Branches used by one anchored rank promotion. -/
def rankBranches (schedule : WTree Nat) (amp : MetaTransformer)
    (base : BusyLean.Transformer) : Nat → BusyLean.Transformer
  | 0 => amp base
  | _ + 1 => metaStage amp base schedule

/-- One anchored promotion of a meta-transformer. -/
def rankStep (schedule : WTree Nat) (amp : MetaTransformer) :
    MetaTransformer :=
  fun base =>
    BusyLean.liftTransformer
      (BusyLean.spliceTransformers (rankBranches schedule amp base))

/-- Finite rank hierarchy of meta-level autonomous lifting. -/
def rankLift (schedule : WTree Nat) : Nat → MetaTransformer
  | 0 => BusyLean.liftTransformer
  | r + 1 => rankStep schedule (rankLift schedule r)

/-- Dynamic-kind reflection with a countable oracle family. -/
def reflectFamily (fs : BusyLean.W.Family) (n : Nat) : Nat :=
  n + 1 + BigNumber.maxN
    (BusyLean.W.prefixMax (fun i => fs i n) n)
    (BigNumber.maximum
      (BusyLean.Fd.fvalue (BusyLean.packFamily fs) n)
      (BusyLean.Fd.ctmsUpTo n))

/-- Contender 13 as a family. -/
def family13 (n : Nat) : Nat := BusyLean.F13 (BusyLean.F13 n)

/-- Previous-family-controlled rank. -/
def diagonalRank14 (n : Nat) : Nat := family13 n + 1

/-- Previous-family-controlled autonomous schedule. -/
def schedule14 (n : Nat) : WTree Nat :=
  BusyLean.Autonomous.realize
    (BusyLean.Autonomous.hyper (diagonalRank14 n)
      (BusyLean.Autonomous.encode BusyLean.tree12))

/-- One family-aware dynamic-kind reflection step. -/
def fdFamilyTransformer : BusyLean.Transformer :=
  fun fs _ n => reflectFamily fs n

/-- Constant seed family generated by Contender 13. -/
def seed13 : BusyLean.W.Family := fun _ => family13

/-- Rank-diagonal family. -/
def rankFamily14 (n : Nat) : BusyLean.W.Family :=
  rankLift (schedule14 n) (diagonalRank14 n)
    fdFamilyTransformer seed13

/-- Final reflection over the complete rank-diagonal family. -/
def F14 (n : Nat) : Nat := reflectFamily (rankFamily14 n) n

/-- Closed incoming candidate. -/
def contender_14 : Nat := F14 (F14 42)

end BusyLean.Incoming14.RankDiagonal
