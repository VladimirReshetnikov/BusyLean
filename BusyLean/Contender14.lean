import BusyLean.Contender13
import BusyLean.MetaReflection
import BusyLean.Autonomous

/-!
# Contender 14: ramified dynamic-kind metareflection

Contender 13 performs one semantic reflection over dynamic-kind System Fω with
Contender 12's family as a unary oracle.  This module turns that reflection
into a progressive transformer on countable oracle families, applies the
repository's operator-level autonomous closure, and iterates the resulting
metastep a Contender-13-sized number of times.

The essential definitions are

```
reflect14 fs n
  = n + 1 + max (max_{i ≤ n} fs i n)
                    (max_{t ∈ CTm(n)} value_{pack fs}(t))

metaTower14 0       = fdTransformer14
metaTower14 (k + 1) = operatorStage (metaTower14 k) tree14

F14 n        = metaTower14 (ramification14 n + 1) seed13 n n
contender_14 = F14 (F14 42).
```

`tree14` is a crowned schedule.  Child zero is a leaf, giving a transparent
strict-growth witness at every metastep.  Every positive child is the much
larger autonomous schedule obtained by applying a Contender-13-sized level of
`Autonomous.hyper` above Contender 12's schedule.

Every definition below is structural and executable.  In particular, there is
no use of `noncomputable`, `partial`, `unsafe`, `opaque`, `implemented_by`, or
`extern`.  Do not evaluate `contender_14`.
-/

namespace BusyLean

open BigNumber (WTree)

/-- Dynamic-kind reflection with a full countable oracle family.

The family is encoded into the unary object-language oracle by `packFamily`.
The explicit prefix maximum is not redundant: it makes progressivity visible
without assuming monotonicity of program evaluation in oracle values (which is
false for branching programs). -/
def reflect14 (fs : W.Family) (n : Nat) : Nat :=
  n + 1 +
    BigNumber.maxN
      (W.prefixMax (fun i => fs i n) n)
      (BigNumber.maximum (Fd.fvalue (packFamily fs) n) (Fd.ctmsUpTo n))

/-- Package family-aware dynamic-kind reflection as a transformer.
The output coordinate is intentionally ignored. -/
def fdTransformer14 : Transformer :=
  fun fs _ n => reflect14 fs n

/-- Contender 13's construction as a function of its input.
Definitionally, `family13 42 = contender_13`; the named constant is not used. -/
def family13 (n : Nat) : Nat := F13 (F13 n)

/-- The constant countable seed family generated by Contender 13. -/
def seed13 : W.Family := fun _ => family13

/-- The number of operator-rank successors used by `F14` at input `n`. -/
def ramification14 (n : Nat) : Nat := family13 (family13 n)

/-- A schedule strictly above Contender 12's explicit schedule, with a
Contender-13-sized finite level of the autonomous higher-derivative syntax. -/
def coreTree14 : WTree Nat :=
  Autonomous.realize
    (Autonomous.hyper (ramification14 42) (Autonomous.encode tree12))

/-- Crown a core schedule with a canonical leaf at branch zero.
The leaf supplies a short formal strictness path; every positive branch retains
the full core schedule. -/
def crown14 (core : WTree Nat) : Nat → WTree Nat
  | 0 => .leaf
  | _ + 1 => core

/-- The crowned autonomous schedule used at every metastep. -/
def tree14 : WTree Nat := .node (crown14 coreTree14)

/-- One ramified operator-level closure. -/
def metaStep14 (op : Transformer) : Transformer :=
  operatorStage op tree14

/-- Iterate ramified operator-level closure through a finite (but enormous)
number of metalevels. -/
def metaTower14 : Nat → Transformer
  | 0 => fdTransformer14
  | k + 1 => metaStep14 (metaTower14 k)

/-- The Contender-14 family.  The `+ 1` ensures that the base dynamic-kind
transformer is passed through at least one full operator-level metastep. -/
def F14 (n : Nat) : Nat :=
  metaTower14 (ramification14 n + 1) seed13 n n

/-- **Contender 14.** Never evaluate it. -/
def contender_14 : Nat := F14 (F14 42)

end BusyLean
