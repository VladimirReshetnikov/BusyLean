import BusyLean.MetaReflection
import BusyLean.ReflectionFacts

/-
Adopted from proposal P6 ("operator reflection", proposals/P6-operator-reflection),
unchanged except for this header. It is generic in its base transformer, and
Contender 12 instantiates it with kind-polymorphic Fω reflection.
-/

/-!
# Direct inequalities for transformer reflection

As in `BusyLean.ReflectionFacts`, no monotonicity of reflection in its oracle is
assumed.  It is false in general because object-language programs may inspect
and branch on oracle values.  Every strict inequality below follows an explicit
occurrence: a visible seed coordinate or a visible child of a W-tree.
-/

namespace BusyLean

open BigNumber (WTree)
open BusyLean.W

/-- A transformer is progressive when every visible seed value is strictly
below every output coordinate at the same numerical input. -/
def Progressive (op : Transformer) : Prop :=
  ∀ (seed : Family) (i o n : Nat), i ≤ n → seed i n < op seed o n

/-- Ordinary reflection is progressive. -/
theorem reflectionTransformer_progressive :
    Progressive reflectionTransformer := by
  intro seed i o n hi
  exact oracle_lt_reflect seed hi

/-- Splicing preserves progressivity when every selected transformer is
progressive. -/
theorem spliceTransformers_progressive {ops : Nat → Transformer}
    (hops : ∀ i, Progressive (ops i)) :
    Progressive (spliceTransformers ops) := by
  intro seed i o n hi
  exact (hops o) seed i 0 n hi

/-- At a transformer-run node, every visible aligned child is strictly below
its parent. -/
theorem runTransformer_child_lt {op : Transformer}
    (hop : Progressive op) (seed : Family) (f : Nat → WTree Nat)
    {i o n : Nat} (hi : i ≤ n) :
    runTransformer op seed (f i) i n <
      runTransformer op seed (.node f) o n := by
  change runTransformer op seed (f i) i n <
    op (fun j m => runTransformer op seed (f j) j m) o n
  exact hop (fun j m => runTransformer op seed (f j) j m) i o n hi

/-- The primitive transformer-run is exactly the old `stage`, independently
of the output coordinate. -/
theorem runTransformer_reflection_eq_stage (seed : Family) :
    ∀ (a : WTree Nat) (o n : Nat),
      runTransformer reflectionTransformer seed a o n = stage seed a n
  | .leaf, _, _ => rfl
  | .node f, o, n => by
      change reflect
          (fun i m => runTransformer reflectionTransformer seed (f i) i m) n =
        reflect (fun i m => stage seed (f i) m) n
      apply congrArg (fun fs : Family => reflect fs n)
      funext i m
      exact runTransformer_reflection_eq_stage seed (f i) i m

/-- Consequently, lifting ordinary reflection is exactly one Contender-6
forest-reflection pass. -/
theorem liftReflection_eq_stage (seed : Family) (o n : Nat) :
    liftTransformer reflectionTransformer seed o n = stage seed index n :=
  runTransformer_reflection_eq_stage seed index o n

/-- Every child of the depth-zero join is a leaf. -/
theorem depthZeroTreeLeaf (i : Nat) :
    defTree (nthD (BigNumber.allTerms 0) i .zero) = .leaf := rfl

/-- A progressive transformer is strictly below its autonomous lift at every
visible output coordinate.  The proof follows the explicit path

`leaf -> treesOfDepth 0 -> index`.
-/
theorem transformer_lt_lift_at {op : Transformer}
    (hop : Progressive op) (seed : Family) {i o n : Nat} (hi : i ≤ n) :
    op seed i n < liftTransformer op seed o n := by
  have h1 :
      runTransformer op seed
          (defTree (nthD (BigNumber.allTerms 0) i .zero)) i n <
        runTransformer op seed (treesOfDepth 0) 0 n :=
    runTransformer_child_lt hop seed
      (fun j => defTree (nthD (BigNumber.allTerms 0) j .zero)) hi
  have h2 :
      runTransformer op seed (treesOfDepth 0) 0 n <
        runTransformer op seed index o n :=
    runTransformer_child_lt hop seed treesOfDepth (Nat.zero_le n)
  rw [depthZeroTreeLeaf] at h1
  exact Nat.lt_trans h1 h2

/-- Autonomous lifting preserves progressivity. -/
theorem liftTransformer_progressive {op : Transformer}
    (hop : Progressive op) : Progressive (liftTransformer op) := by
  intro seed i o n hi
  exact Nat.lt_trans (hop seed i i n hi)
    (transformer_lt_lift_at hop seed hi)

/-- Every operator generated by `operatorStage` is progressive. -/
theorem operatorStage_progressive (base : Transformer)
    (hbase : Progressive base) :
    (a : WTree Nat) → Progressive (operatorStage base a)
  | .leaf => liftTransformer_progressive hbase
  | .node f =>
      liftTransformer_progressive
        (spliceTransformers_progressive
          (fun i => operatorStage_progressive base hbase (f i)))

/-- Every visible child operator is strictly below its operator-stage parent.
The child is used at its canonical output coordinate `0`; coordinate `i` of the
splice names child `i`. -/
theorem operatorStage_child_lt (base : Transformer)
    (hbase : Progressive base) (seed : Family) (f : Nat → WTree Nat)
    {i o n : Nat} (hi : i ≤ n) :
    operatorStage base (f i) seed 0 n <
      operatorStage base (.node f) seed o n := by
  change spliceTransformers (fun j => operatorStage base (f j)) seed i n <
    liftTransformer
      (spliceTransformers (fun j => operatorStage base (f j))) seed o n
  exact transformer_lt_lift_at
    (spliceTransformers_progressive
      (fun j => operatorStage_progressive base hbase (f j))) seed hi

end BusyLean
